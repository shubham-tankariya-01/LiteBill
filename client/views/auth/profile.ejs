<% layout('layouts/boilerplate') %>

<%
    const mobileNumber = user && user.mobile_number ? `+91 ${user.mobile_number}` : '+91 User';
    const initials = user && user.mobile_number ? user.mobile_number.toString().slice(0, 1) : 'U';
    const memberSince = user && user.createdAt
        ? new Date(user.createdAt).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
        : 'Recently';
%>

<div class="profile-page">
    <header class="page-header profile-header">
        <div>
            <h1 class="profile-title">
                <i data-lucide="user" aria-hidden="true"></i>
                <span>Your Profile</span>
            </h1>
            <p class="profile-subtitle">Manage your account details and keep your security settings up to date.</p>
        </div>
    </header>

    <% if (error) { %>
        <div class="profile-banner profile-banner-error">
            <i data-lucide="alert-circle" aria-hidden="true"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <% if (success) { %>
        <div class="profile-banner profile-banner-success">
            <i data-lucide="check-circle-2" aria-hidden="true"></i>
            <span><%= success %></span>
        </div>
    <% } %>

    <div class="profile-layout">
        <section class="card profile-sidebar">
            <div class="profile-identity">
                <div class="profile-avatar" aria-hidden="true"><%= initials %></div>
                <div class="profile-identity-copy">
                    <h2><%= mobileNumber %></h2>
                    <p>Member since <%= memberSince %></p>
                </div>
            </div>

            <div class="profile-divider"></div>

            <div class="profile-stats">
                <div class="stat-label">Account Statistics</div>

                <div class="profile-stat-row">
                    <div class="profile-stat-label">
                        <i data-lucide="home" class="profile-stat-icon profile-stat-icon-orange" aria-hidden="true"></i>
                        <span>Properties</span>
                    </div>
                    <strong><%= stats.propertiesCount %></strong>
                </div>

                <div class="profile-stat-row">
                    <div class="profile-stat-label">
                        <i data-lucide="bed-double" class="profile-stat-icon profile-stat-icon-purple" aria-hidden="true"></i>
                        <span>Configured Meters</span>
                    </div>
                    <strong><%= stats.roomsCount %></strong>
                </div>

                <div class="profile-stat-row">
                    <div class="profile-stat-label">
                        <i data-lucide="file-text" class="profile-stat-icon profile-stat-icon-blue" aria-hidden="true"></i>
                        <span>Main Bills Tracked</span>
                    </div>
                    <strong><%= stats.billsCount %></strong>
                </div>
            </div>
        </section>

        <section class="card profile-security-card">
            <div class="profile-section-heading">
                <i data-lucide="shield-check" aria-hidden="true"></i>
                <span>Security Settings</span>
            </div>

            <form action="/auth/change-password" method="POST" id="passwordForm" class="profile-password-form">
                <div class="form-group">
                    <label class="form-label" for="current_password">Current Password</label>
                    <div class="profile-password-field">
                        <input type="password" id="current_password" name="current_password" class="form-input" required>
                        <button type="button" class="profile-password-toggle" data-target="current_password" aria-label="Toggle current password visibility">
                            <i data-lucide="eye" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="new_password">New Password</label>
                    <div class="profile-password-field">
                        <input type="password" id="new_password" name="new_password" class="form-input" required minlength="6">
                        <button type="button" class="profile-password-toggle" data-target="new_password" aria-label="Toggle new password visibility">
                            <i data-lucide="eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="profile-strength-bars" aria-hidden="true">
                        <span class="profile-strength-bar"></span>
                        <span class="profile-strength-bar"></span>
                        <span class="profile-strength-bar"></span>
                    </div>
                    <p id="strengthText" class="profile-helper-text">Enter a password</p>
                </div>

                <div class="form-group">
                    <label class="form-label" for="confirm_password">Confirm New Password</label>
                    <div class="profile-password-field">
                        <input type="password" id="confirm_password" class="form-input" required minlength="6">
                        <button type="button" class="profile-password-toggle" data-target="confirm_password" aria-label="Toggle confirm password visibility">
                            <i data-lucide="eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <p id="matchMessage" class="profile-helper-text profile-helper-error hidden">Passwords do not match</p>
                </div>

                <button type="submit" class="btn btn-primary profile-submit-btn">Update Password →</button>
            </form>
        </section>
    </div>

    <section class="profile-danger-zone">
        <div>
            <h2>Danger Zone</h2>
            <p>These actions affect your current session and account access. Please continue carefully.</p>
        </div>

        <div class="profile-danger-divider"></div>

        <div class="profile-danger-actions">
            <form action="/auth/logout" method="POST">
                <button type="submit" class="btn btn-secondary profile-danger-btn">
                    <i data-lucide="log-out" aria-hidden="true"></i>
                    <span>Sign Out of LiteBill</span>
                </button>
            </form>

            <button
                type="button"
                class="btn profile-delete-btn"
                onclick="alert('Account deletion is currently unavailable. Please contact support.')"
            >
                <i data-lucide="trash-2" aria-hidden="true"></i>
                <span>Delete Account</span>
            </button>
        </div>
    </section>
</div>

<style>
    .profile-page {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .profile-header {
        margin-bottom: 0;
    }

    .profile-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .profile-title i {
        width: 26px;
        height: 26px;
        color: var(--accent-orange);
    }

    .profile-subtitle {
        margin-top: 8px;
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    .profile-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        border-radius: 12px;
        padding: 14px 16px;
        font-weight: 600;
    }

    .profile-banner i {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .profile-banner-error {
        background: #FEF2F2;
        border-left: 4px solid #EF4444;
        color: #B91C1C;
    }

    .profile-banner-success {
        background: #ECFDF3;
        border-left: 4px solid #4CAF7D;
        color: #2E7D52;
    }

    .profile-layout {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        align-items: stretch;
    }

    .profile-sidebar {
        flex: 1;
        min-width: 280px;
        padding: 28px;
        display: flex;
        flex-direction: column;
    }

    .profile-security-card {
        flex: 1.5;
        min-width: 340px;
        padding: 28px;
    }

    .profile-identity {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .profile-avatar {
        width: 96px;
        height: 96px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #FF6B2B 0%, #8B5CF6 100%);
        color: #FFFFFF;
        font-size: 2.5rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 18px;
        box-shadow: 0 16px 28px rgba(255, 107, 43, 0.18);
    }

    .profile-identity-copy h2 {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--text-primary);
        margin-bottom: 6px;
    }

    .profile-identity-copy p {
        color: var(--text-secondary);
        font-size: 0.85rem;
    }

    .profile-divider,
    .profile-danger-divider {
        height: 1px;
        background: var(--border-subtle);
        margin: 20px 0;
    }

    .profile-stats {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .profile-stat-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: var(--surface-soft);
        border-radius: 12px;
        padding: 12px 16px;
    }

    .profile-stat-label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--text-primary);
        font-weight: 700;
    }

    .profile-stat-row strong {
        color: var(--text-primary);
        font-size: 1rem;
        font-weight: 800;
    }

    .profile-stat-icon {
        width: 18px;
        height: 18px;
    }

    .profile-stat-icon-orange {
        color: var(--accent-orange);
    }

    .profile-stat-icon-purple {
        color: #8B5CF6;
    }

    .profile-stat-icon-blue {
        color: var(--accent-blue);
    }

    .profile-section-heading {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .profile-section-heading i {
        width: 20px;
        height: 20px;
        color: var(--accent-blue);
    }

    .profile-password-form .form-group {
        margin-bottom: 20px;
    }

    .profile-password-field {
        position: relative;
    }

    .profile-password-field .form-input {
        padding-right: 52px;
    }

    .profile-password-toggle {
        position: absolute;
        top: 50%;
        right: 10px;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        color: var(--text-secondary);
        transform: translateY(-50%);
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .profile-password-toggle:hover {
        background: var(--surface-muted);
        color: var(--text-primary);
    }

    .profile-password-toggle i {
        width: 18px;
        height: 18px;
        margin: 0 auto;
    }

    .profile-strength-bars {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
        margin-top: 10px;
    }

    .profile-strength-bar {
        height: 6px;
        border-radius: 999px;
        background: var(--border-subtle);
        transition: background 0.2s ease;
    }

    .profile-helper-text {
        margin-top: 8px;
        color: var(--text-secondary);
        font-size: 0.8rem;
        font-weight: 600;
    }

    .profile-helper-error {
        color: #DC2626;
    }

    .profile-submit-btn {
        width: 100%;
        margin-top: 8px;
    }

    .profile-danger-zone {
        background: var(--surface);
        border: 1.5px solid #FECACA;
        border-left: 4px solid #EF4444;
        border-radius: 20px;
        padding: 24px;
        box-shadow: var(--shadow-card-soft);
    }

    .profile-danger-zone h2 {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 6px;
    }

    .profile-danger-zone p {
        color: var(--text-secondary);
    }

    .profile-danger-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .profile-danger-actions form {
        margin: 0;
    }

    .profile-danger-btn,
    .profile-delete-btn {
        min-width: 210px;
    }

    .profile-delete-btn {
        background: transparent;
        color: #DC2626;
        border: 1.5px solid #FCA5A5;
    }

    .profile-delete-btn:hover {
        border-color: #DC2626;
        background: #FEF2F2;
    }

    @media (max-width: 768px) {
        .profile-sidebar,
        .profile-security-card,
        .profile-danger-zone {
            width: 100%;
        }

        .profile-identity {
            flex-direction: row;
            align-items: center;
            gap: 16px;
            text-align: left;
        }

        .profile-avatar {
            width: 72px;
            height: 72px;
            margin-bottom: 0;
            font-size: 2rem;
            flex-shrink: 0;
        }

        .profile-danger-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .profile-danger-actions form,
        .profile-danger-btn,
        .profile-delete-btn {
            width: 100%;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const toggles = document.querySelectorAll('.profile-password-toggle');
        const newPassword = document.getElementById('new_password');
        const confirmPassword = document.getElementById('confirm_password');
        const form = document.getElementById('passwordForm');
        const strengthBars = Array.from(document.querySelectorAll('.profile-strength-bar'));
        const strengthText = document.getElementById('strengthText');
        const matchMessage = document.getElementById('matchMessage');

        const resetStrength = () => {
            strengthBars.forEach((bar) => {
                bar.style.background = 'var(--border-subtle)';
            });
            strengthText.textContent = 'Enter a password';
            strengthText.style.color = 'var(--text-secondary)';
        };

        const updateStrength = (value) => {
            if (!value) {
                resetStrength();
                return;
            }

            let score = 0;
            if (value.length >= 6) score += 1;
            if (/[A-Z0-9]/.test(value)) score += 1;
            if (value.length >= 10 && /[^A-Za-z0-9]/.test(value)) score += 1;

            resetStrength();

            if (score >= 1) {
                strengthBars[0].style.background = '#EF4444';
                strengthText.textContent = 'Weak';
                strengthText.style.color = '#EF4444';
            }
            if (score >= 2) {
                strengthBars[0].style.background = '#F59E0B';
                strengthBars[1].style.background = '#F59E0B';
                strengthText.textContent = 'Good';
                strengthText.style.color = '#D97706';
            }
            if (score >= 3) {
                strengthBars.forEach((bar) => {
                    bar.style.background = 'var(--accent-green)';
                });
                strengthText.textContent = 'Strong';
                strengthText.style.color = 'var(--accent-green)';
            }
        };

        const validateMatch = () => {
            if (!confirmPassword.value) {
                matchMessage.classList.add('hidden');
                confirmPassword.style.borderColor = '';
                return true;
            }

            const isMatch = confirmPassword.value === newPassword.value;
            matchMessage.classList.toggle('hidden', isMatch);
            confirmPassword.style.borderColor = isMatch ? '' : '#EF4444';
            return isMatch;
        };

        toggles.forEach((toggle) => {
            toggle.addEventListener('click', () => {
                const target = document.getElementById(toggle.dataset.target);
                const icon = toggle.querySelector('i');
                const nextType = target.type === 'password' ? 'text' : 'password';
                target.type = nextType;
                icon.setAttribute('data-lucide', nextType === 'password' ? 'eye' : 'eye-off');
                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            });
        });

        newPassword.addEventListener('input', (event) => {
            updateStrength(event.target.value);
            validateMatch();
        });

        confirmPassword.addEventListener('input', validateMatch);

        form.addEventListener('submit', (event) => {
            if (!validateMatch()) {
                event.preventDefault();
            }
        });

        resetStrength();
    });
</script>
