<% layout('layouts/boilerplate') %>

<style>
    /* Hide default navbar and main container padding for full-bleed auth pages */
    .top-navbar { display: none !important; }
    .main-container { padding: 0 !important; max-width: 100% !important; }

    /* Layout */
    .auth-split-layout {
        display: flex;
        min-height: 100vh;
        width: 100%;
    }

    /* Left Panel */
    .auth-left-panel {
        flex: 1;
        background: var(--gradient-hero);
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 4rem;
        color: #fff;
        overflow: hidden;
    }

    .auth-left-content {
        animation: slideInLeft 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .auth-logo-large {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 3rem;
    }

    .auth-tagline {
        font-size: 2.75rem;
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 2rem;
        max-width: 450px;
    }

    .auth-features {
        list-style: none;
        padding: 0;
        margin-bottom: 3rem;
    }

    .auth-features li {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 1.15rem;
        font-weight: 500;
        margin-bottom: 1.25rem;
    }

    .auth-features i {
        background: rgba(255,255,255,0.2);
        padding: 0.35rem;
        border-radius: 50%;
        color: #fff;
    }

    .auth-testimonial {
        background: rgba(0,0,0,0.2);
        backdrop-filter: blur(10px);
        padding: 1.5rem;
        border-radius: var(--radius-card);
        border: 1px solid rgba(255,255,255,0.1);
        max-width: 450px;
        animation: slideInLeft 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: 0.2s;
        opacity: 0;
    }

    /* Right Panel */
    .auth-right-panel {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-body);
        padding: 2rem;
    }

    .auth-form-container {
        width: 100%;
        max-width: 400px;
    }

    .mobile-logo {
        display: none;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 2.5rem;
        color: var(--text-primary);
        text-decoration: none;
    }
    
    .mobile-logo i {
        color: var(--accent-orange);
    }

    /* Form Styles */
    .auth-heading {
        font-size: 1.75rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
    }

    .auth-subheading {
        color: var(--text-secondary);
        margin-bottom: 2.5rem;
        font-size: 0.95rem;
    }

    .input-group {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-prefix {
        position: absolute;
        left: 1rem;
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.95rem;
        pointer-events: none;
    }

    .input-with-prefix {
        padding-left: 3rem !important;
    }

    .input-toggle-btn {
        position: absolute;
        right: 0.5rem;
        background: none;
        border: none;
        color: var(--text-secondary);
        padding: 0.5rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .input-toggle-btn:hover {
        color: var(--text-primary);
    }

    .auth-submit-btn {
        width: 100%;
        background: var(--accent-orange);
        color: #fff;
        padding: 0.9rem;
        font-size: 1rem;
        font-weight: 700;
        border: none;
        border-radius: var(--radius-btn);
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .auth-submit-btn:hover {
        filter: brightness(1.1);
        transform: translateY(-1px);
    }
    
    .auth-submit-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
        transform: none;
    }

    /* Staggered Animations */
    .stagger-1 { animation: fadeUp 0.4s ease forwards; opacity: 0; animation-delay: 50ms; }
    .stagger-2 { animation: fadeUp 0.4s ease forwards; opacity: 0; animation-delay: 100ms; }
    .stagger-3 { animation: fadeUp 0.4s ease forwards; opacity: 0; animation-delay: 150ms; }
    .stagger-4 { animation: fadeUp 0.4s ease forwards; opacity: 0; animation-delay: 200ms; }
    .stagger-5 { animation: fadeUp 0.4s ease forwards; opacity: 0; animation-delay: 250ms; }

    @keyframes slideInLeft {
        from { opacity: 0; transform: translateX(-30px); }
        to { opacity: 1; transform: translateX(0); }
    }

    .spinner {
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255,255,255,0.3);
        border-radius: 50%;
        border-top-color: #fff;
        animation: spin 1s ease-in-out infinite;
        display: none;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    .auth-submit-btn.loading .btn-text { display: none; }
    .auth-submit-btn.loading .spinner { display: block; }

    @media (max-width: 900px) {
        .auth-left-panel { display: none; }
        .mobile-logo { display: flex; }
        .auth-right-panel { padding: 2rem 1.5rem; }
    }
</style>

<div class="auth-split-layout">
    <div class="auth-left-panel">
        <div class="auth-left-content">
            <div class="auth-logo-large">
                <i data-lucide="zap" style="color: #fff; width: 32px; height: 32px;"></i> LiteBill
            </div>
            <h1 class="auth-tagline">Smart billing for smart landlords.</h1>
            <ul class="auth-features">
                <li><i data-lucide="check" style="width: 18px; height: 18px;"></i> Automatic bill splitting</li>
                <li><i data-lucide="check" style="width: 18px; height: 18px;"></i> Full billing history</li>
                <li><i data-lucide="check" style="width: 18px; height: 18px;"></i> Multi-property support</li>
            </ul>
        </div>
        <div class="auth-testimonial">
            <p style="font-style: italic; font-size: 1.05rem; margin-bottom: 1rem; line-height: 1.5;">"LiteBill completely eliminated the monthly headache of calculating utility splits. My tenants appreciate the transparency, and I save hours every billing cycle."</p>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 40px; height: 40px; border-radius: 50%; background: #fff; color: var(--accent-orange); display: flex; align-items: center; justify-content: center; font-weight: 800;">A</div>
                <div>
                    <div style="font-weight: 700; color: #fff;">Arjun M.</div>
                    <div style="font-size: 0.8rem; opacity: 0.8;">Property Manager, 14 Units</div>
                </div>
            </div>
        </div>
    </div>

    <div class="auth-right-panel">
        <div class="auth-form-container">
            <a href="/" class="mobile-logo stagger-1">
                <i data-lucide="zap" style="width: 28px; height: 28px;"></i> LiteBill
            </a>
            
            <h2 class="auth-heading stagger-1">Create your account</h2>
            <p class="auth-subheading stagger-1">Sign up to start tracking bills and properties today.</p>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="stagger-2" style="background: rgba(239, 68, 68, 0.08); border-left: 3px solid var(--accent-red); border-radius: var(--radius-sm); padding: 0.85rem 1rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; animation: fadeUp 0.3s ease forwards;">
                    <i data-lucide="alert-circle" style="width: 16px; height: 16px; color: var(--accent-red); flex-shrink: 0;"></i>
                    <span style="color: var(--accent-red); font-size: 0.875rem; font-weight: 500;"><%= error %></span>
                </div>
            <% } %>

            <form action="/auth/signup" method="POST" id="signupForm">
                <div class="form-group stagger-2">
                    <label class="form-label" for="mobile_number">Mobile Number</label>
                    <div class="input-group">
                        <span class="input-prefix">+91</span>
                        <input type="text" id="mobile_number" name="mobile_number" class="form-input input-with-prefix"
                            required placeholder="Enter 10-digit number"
                            value="<%= typeof mobileValue !== 'undefined' ? mobileValue : '' %>"
                            maxlength="10" pattern="\d{10}">
                    </div>
                </div>

                <div class="form-group stagger-3">
                    <label class="form-label" for="password">Password</label>
                    <div class="input-group">
                        <input type="password" id="password" name="password" class="form-input"
                            required placeholder="Create a password">
                        <button type="button" class="input-toggle-btn" id="togglePassword" tabindex="-1">
                            <i data-lucide="eye" style="width: 18px; height: 18px;"></i>
                        </button>
                    </div>
                    <!-- Strength indicator -->
                    <div style="display: flex; gap: 4px; margin-top: 0.5rem; height: 4px;" id="strengthBars">
                        <div style="flex: 1; background: var(--border); border-radius: 2px; transition: background 0.3s;"></div>
                        <div style="flex: 1; background: var(--border); border-radius: 2px; transition: background 0.3s;"></div>
                        <div style="flex: 1; background: var(--border); border-radius: 2px; transition: background 0.3s;"></div>
                        <div style="flex: 1; background: var(--border); border-radius: 2px; transition: background 0.3s;"></div>
                    </div>
                    <div id="strengthText" style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.25rem; text-align: right; min-height: 15px;"></div>
                </div>

                <div class="form-group stagger-4">
                    <label class="form-label" for="confirm_password">Confirm Password</label>
                    <div class="input-group">
                        <input type="password" id="confirm_password" name="confirm_password" class="form-input"
                            required placeholder="••••••••">
                        <div class="input-toggle-btn" style="pointer-events: none; opacity: 1;" id="confirmStatus">
                            <!-- Icon injected via JS -->
                        </div>
                    </div>
                    <p id="confirmError" style="font-size: 0.8rem; color: var(--accent-red); margin-top: 0.35rem; display: none;">
                        Passwords do not match.
                    </p>
                </div>

                <p class="stagger-4" style="color: var(--text-dim); font-size: 0.75rem; line-height: 1.4; margin-bottom: 1.5rem;">
                    By creating an account you agree to responsible data management and our Terms of Service.
                </p>

                <div class="stagger-4">
                    <button type="submit" class="auth-submit-btn" id="submitBtn">
                        <span class="btn-text">Create Account</span>
                        <div class="spinner"></div>
                    </button>
                </div>
            </form>

            <p class="stagger-5" style="text-align: center; margin-top: 2rem; color: var(--text-secondary); font-size: 0.9rem;">
                Already have an account? <a href="/auth/login" style="color: var(--text-primary); font-weight: 600;">Log In</a>
            </p>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Toggle password visibility
        const toggleBtn = document.getElementById('togglePassword');
        const pwdInput = document.getElementById('password');
        
        if(toggleBtn && pwdInput) {
            toggleBtn.addEventListener('click', () => {
                const type = pwdInput.getAttribute('type') === 'password' ? 'text' : 'password';
                pwdInput.setAttribute('type', type);
                toggleBtn.innerHTML = type === 'password' ? '<i data-lucide="eye" style="width: 18px; height: 18px;"></i>' : '<i data-lucide="eye-off" style="width: 18px; height: 18px;"></i>';
                if (typeof lucide !== 'undefined') lucide.createIcons();
            });
        }

        // Password strength logic
        const bars = document.getElementById('strengthBars').children;
        const text = document.getElementById('strengthText');
        
        pwdInput.addEventListener('input', (e) => {
            const val = e.target.value;
            let strength = 0;
            if(val.length >= 6) strength++;
            if(val.length >= 8) strength++;
            if(/[A-Z]/.test(val)) strength++;
            if(/[0-9!@#\$%\^&\*]/.test(val)) strength++;
            
            // reset bars
            for(let i=0; i<4; i++) bars[i].style.background = 'var(--border)';
            
            if(val.length === 0) { text.textContent = ''; return; }
            
            const colors = ['var(--accent-red)', 'var(--accent-yellow)', 'var(--accent-blue)', 'var(--accent-green)'];
            const labels = ['Weak', 'Fair', 'Strong', 'Very Strong'];
            
            const idx = Math.min(Math.max(strength - 1, 0), 3);
            for(let i=0; i<=idx; i++) {
                bars[i].style.background = colors[idx];
            }
            text.textContent = labels[idx];
            text.style.color = colors[idx];
        });

        // Confirm Password Status logic
        const confirmInput = document.getElementById('confirm_password');
        const confirmStatus = document.getElementById('confirmStatus');
        const confirmError = document.getElementById('confirmError');
        
        const checkMatch = () => {
            if(confirmInput.value.length === 0) {
                confirmStatus.innerHTML = '';
                confirmError.style.display = 'none';
                return;
            }
            if(confirmInput.value === pwdInput.value) {
                confirmStatus.innerHTML = '<i data-lucide="check" style="width: 18px; height: 18px; color: var(--accent-green);"></i>';
                confirmError.style.display = 'none';
            } else {
                confirmStatus.innerHTML = '<i data-lucide="x" style="width: 18px; height: 18px; color: var(--accent-red);"></i>';
                confirmError.style.display = 'block';
            }
            if (typeof lucide !== 'undefined') lucide.createIcons();
        };

        confirmInput.addEventListener('input', checkMatch);
        pwdInput.addEventListener('input', checkMatch);

        // Submit loading state & final validation
        const form = document.getElementById('signupForm');
        const submitBtn = document.getElementById('submitBtn');
        if(form && submitBtn) {
            form.addEventListener('submit', (e) => {
                if(confirmInput.value !== pwdInput.value) {
                    e.preventDefault();
                    confirmError.style.display = 'block';
                    return;
                }
                submitBtn.classList.add('loading');
                submitBtn.disabled = true;
            });
        }
    });
</script>
