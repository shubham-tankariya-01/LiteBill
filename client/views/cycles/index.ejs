<% layout('layouts/boilerplate') %>

<div class="cycles-breadcrumb">Properties / <span><%= house.house_name %></span> / Billing Cycles</div>

<section class="cycles-header">
    <h1 class="cycles-title">
        <i data-lucide="refresh-cw"></i>
        <span>Billing Timeline</span>
    </h1>
</section>

<section class="cycles-timeline">
    <div class="cycles-timeline-line"></div>

    <% if (cycles.length === 0) { %>
        <div class="card empty-state cycles-empty-state">
            <div class="empty-state-icon">
                <i data-lucide="refresh-cw" style="width: 28px; height: 28px; color: #5B8DEF;"></i>
            </div>
            <div class="empty-state-title">No Cycles Yet</div>
            <div class="empty-state-description">Complete the initial setup and supplier bill entry to start your first billing cycle.</div>
        </div>
    <% } else { %>
        <% cycles.forEach((cycle) => {
            const cycleData = cycleResults[cycle._id];
            const isActive = !cycle.endDate;
            const start = new Date(cycle.startDate);
            const end = cycle.endDate ? new Date(cycle.endDate) : new Date();
            const daysRunning = Math.max(1, Math.ceil((end - start) / (1000 * 60 * 60 * 24)));
            const startDateStr = start.toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' });
            const endDateStr = cycle.endDate ? new Date(cycle.endDate).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Present';
            const mainBill = cycleData.mainBill;
            const roomBills = cycleData.roomBills || [];
            const roomCount = cycleData.roomBillsCount || 0;
            const totalAmount = mainBill ? Number(mainBill.total_amount || 0) : 0;
            const ratePerUnit = mainBill && Number(mainBill.total_units || 0) > 0 ? (totalAmount / Number(mainBill.total_units || 1)).toFixed(2) : '0.00';
            const colors = ['#FF6B2B', '#5B8DEF', '#4CAF7D', '#8B5CF6'];
        %>
            <article class="cycles-item">
                <div class="cycles-node <%= isActive ? 'is-active' : 'is-complete' %>">
                    <% if (isActive) { %>
                        <span class="cycles-node-pulse"></span>
                    <% } %>
                </div>

                <% if (isActive) { %>
                    <div class="cycles-card cycles-card-active">
                        <div class="cycles-active-top">
                            <div>
                                <div class="cycles-active-title-row">
                                    <h3>Current Cycle</h3>
                                    <span class="cycles-live-pill">LIVE</span>
                                </div>
                                <div class="cycles-date-range"><%= startDateStr %> - Present</div>
                            </div>

                            <div class="cycles-days-col">
                                <div class="cycles-days-value"><%= daysRunning %></div>
                                <div class="cycles-days-label">Days Running</div>
                            </div>
                        </div>

                        <div class="cycles-active-body">
                            <% if (!mainBill) { %>
                                <i data-lucide="receipt" class="cycles-state-icon" style="color: #FF6B2B;"></i>
                                <h4>Awaiting Supplier Bill</h4>
                                <p>Enter the supplier bill first so the system can calculate the rate per unit for this cycle.</p>
                                <a href="/houses/<%= houseId %>/main-bill/new" class="btn btn-accent">Enter Main Bill -&gt;</a>
                            <% } else { %>
                                <i data-lucide="gauge" class="cycles-state-icon" style="color: #4CAF7D;"></i>
                                <h4>Awaiting Room Readings</h4>
                                <p>Supplier bill recorded (₹<%= totalAmount.toLocaleString('en-IN') %>). Record room readings now to close this cycle.</p>
                                <a href="/houses/<%= houseId %>/cycles/<%= cycle._id %>/readings/new" class="btn btn-primary">Record Readings -&gt;</a>
                            <% } %>
                        </div>
                    </div>
                <% } else { %>
                    <div class="cycles-card cycles-card-complete">
                        <div class="cycles-complete-top">
                            <div>
                                <h3><%= startDateStr %> - <%= endDateStr %></h3>
                                <div class="cycles-duration"><%= daysRunning %> Days Duration</div>
                            </div>
                            <a href="/cycles/<%= cycle._id %>/room-bills" class="cycles-distribution-btn">View Distribution -&gt;</a>
                        </div>

                        <div class="cycles-chip-row">
                            <div class="cycles-stat-chip">
                                <div class="cycles-stat-chip-label">Total Billed</div>
                                <div class="cycles-stat-chip-value">₹<%= totalAmount.toLocaleString('en-IN') %></div>
                            </div>
                            <div class="cycles-stat-chip">
                                <div class="cycles-stat-chip-label">Rate</div>
                                <div class="cycles-stat-chip-value">₹<%= ratePerUnit %>/U</div>
                            </div>
                            <div class="cycles-stat-chip">
                                <div class="cycles-stat-chip-label">Meters Billed</div>
                                <div class="cycles-stat-chip-value"><%= roomCount %></div>
                            </div>
                        </div>

                        <% if (roomBills.length > 0 && totalAmount > 0) { %>
                            <div class="cycles-distribution-wrap">
                                <div class="cycles-distribution-bar">
                                    <% roomBills.forEach((roomBill, index) => {
                                        const width = Math.max((Number(roomBill.amount || 0) / totalAmount) * 100, 4);
                                    %>
                                        <span style="width: <%= width %>%; background: <%= colors[index % colors.length] %>;"></span>
                                    <% }) %>
                                </div>

                                <div class="cycles-legend">
                                    <% roomBills.slice(0, 4).forEach((roomBill, index) => { %>
                                        <div class="cycles-legend-item">
                                            <span class="cycles-legend-color" style="background: <%= colors[index % colors.length] %>;"></span>
                                            <span><%= roomBill.room_id ? roomBill.room_id.meter_name : 'Room' %></span>
                                        </div>
                                    <% }) %>
                                    <% if (roomBills.length > 4) { %>
                                        <div class="cycles-legend-item cycles-legend-more">+<%= roomBills.length - 4 %> more</div>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </article>
        <% }) %>
    <% } %>
</section>

<style>
    .cycles-breadcrumb {
        margin-bottom: 14px;
        color: #7A7A8A;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .cycles-breadcrumb span {
        color: #1A1A1A;
    }

    .cycles-header {
        margin-bottom: 24px;
    }

    .cycles-title {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 1.75rem;
        font-weight: 800;
        line-height: 1.1;
    }

    .cycles-title i {
        width: 24px;
        height: 24px;
        color: #5B8DEF;
    }

    .cycles-timeline {
        position: relative;
        max-width: 760px;
        margin: 0 auto;
        padding-left: 32px;
    }

    .cycles-timeline-line {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        border-radius: 2px;
        background: #E8E7E2;
    }

    .cycles-item {
        position: relative;
        margin-bottom: 24px;
    }

    .cycles-node {
        position: absolute;
        left: -32px;
        top: 28px;
        transform: translateY(-50%);
        width: 16px;
        height: 16px;
        border-radius: 999px;
        border: 4px solid #F2F1EC;
        z-index: 2;
    }

    .cycles-node.is-active {
        background: #FF6B2B;
    }

    .cycles-node.is-complete {
        background: #1F1F1F;
    }

    .cycles-node-pulse {
        position: absolute;
        inset: -8px;
        border-radius: 999px;
        border: 2px solid rgba(255, 107, 43, 0.3);
        animation: cyclesPulse 2s infinite;
    }

    .cycles-card {
        background: #FFFFFF;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.07);
    }

    .cycles-card-active {
        border-left: 3px solid #FF6B2B;
    }

    .cycles-card-complete {
        border-left: 3px solid #E8E7E2;
    }

    .cycles-active-top,
    .cycles-complete-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .cycles-active-title-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 6px;
    }

    .cycles-active-title-row h3,
    .cycles-complete-top h3 {
        font-size: 1rem;
        font-weight: 800;
        color: #1A1A1A;
    }

    .cycles-live-pill {
        min-height: 28px;
        padding: 4px 10px;
        border-radius: 999px;
        background: #FFF0E6;
        color: #FF6B2B;
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .cycles-date-range,
    .cycles-duration {
        color: #7A7A8A;
        font-size: 0.82rem;
    }

    .cycles-days-col {
        text-align: right;
    }

    .cycles-days-value {
        font-size: 1.4rem;
        font-weight: 800;
        color: #1A1A1A;
    }

    .cycles-days-label {
        color: #7A7A8A;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .cycles-active-body {
        border: 1.5px dashed #E8E7E2;
        border-radius: 16px;
        padding: 24px;
        text-align: center;
    }

    .cycles-state-icon {
        width: 24px;
        height: 24px;
        margin: 0 auto 10px;
    }

    .cycles-active-body h4 {
        margin-bottom: 8px;
        font-size: 1rem;
        font-weight: 700;
        color: #1A1A1A;
    }

    .cycles-active-body p {
        margin-bottom: 16px;
        color: #7A7A8A;
        font-size: 0.88rem;
        line-height: 1.55;
    }

    .cycles-distribution-btn {
        min-height: 40px;
        padding: 0 16px;
        border-radius: 999px;
        border: 1.5px solid #5B8DEF;
        color: #2C5CC5;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .cycles-chip-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .cycles-stat-chip {
        padding: 12px 16px;
        border-radius: 12px;
        background: #F7F6F2;
    }

    .cycles-stat-chip-label {
        margin-bottom: 4px;
        color: #7A7A8A;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .cycles-stat-chip-value {
        color: #1A1A1A;
        font-size: 1.1rem;
        font-weight: 800;
    }

    .cycles-distribution-wrap {
        margin-top: 8px;
    }

    .cycles-distribution-bar {
        display: flex;
        width: 100%;
        height: 10px;
        overflow: hidden;
        border-radius: 999px;
        background: #E8E7E2;
        margin-bottom: 10px;
    }

    .cycles-distribution-bar span {
        display: block;
        height: 100%;
    }

    .cycles-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 14px;
    }

    .cycles-legend-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #7A7A8A;
        font-size: 0.74rem;
    }

    .cycles-legend-color {
        width: 8px;
        height: 8px;
        border-radius: 2px;
        display: inline-block;
    }

    .cycles-legend-more {
        color: #7A7A8A;
        font-weight: 600;
    }

    .cycles-empty-state {
        min-height: 300px;
    }

    @keyframes cyclesPulse {
        0% {
            transform: scale(0.9);
            opacity: 0.7;
        }
        100% {
            transform: scale(1.45);
            opacity: 0;
        }
    }

    @media (max-width: 768px) {
        .cycles-timeline {
            padding-left: 24px;
        }

        .cycles-node {
            left: -24px;
        }

        .cycles-chip-row {
            display: flex;
            overflow-x: auto;
            gap: 10px;
            scrollbar-width: none;
        }

        .cycles-chip-row::-webkit-scrollbar {
            display: none;
        }

        .cycles-stat-chip {
            min-width: 140px;
            flex-shrink: 0;
        }
    }
</style>
