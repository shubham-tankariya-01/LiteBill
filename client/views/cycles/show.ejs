<% layout('layouts/boilerplate') %>

<div class="top-header" style="margin-bottom: 2rem;">
    <h1>Cycle <%= cycleId %></h1>
    <div class="top-filters">
        <div class="filter-pill active">Overview</div>
        <a href="/cycles/<%= cycleId %>/room-bills" class="btn btn-primary" style="margin-left: 1rem;"><i data-lucide="calculator" style="width: 14px; margin-right: 4px;"></i> Calculate Bills</a>
    </div>
</div>

<div class="grid-layout">
    <!-- Main Bill Card -->
    <div class="analytic-card" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
        <div style="padding: 1.5rem 1.5rem 0 1.5rem; display: flex; justify-content: space-between;">
            <h3 style="margin: 0;">Main Bill</h3>
            <span style="font-size: 0.75rem; background: rgba(251, 203, 69, 0.3); color: #B38F2B; padding: 0.2rem 0.6rem; border-radius: 99px; font-weight: 600;">Pending</span>
        </div>
        <div style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center;">
            <i data-lucide="file-text" style="width: 40px; height: 40px; color: var(--text-light); margin-bottom: 1rem;"></i>
            <p style="color: var(--text-muted); font-size: 0.85rem; text-align: center;">Total Supplier Data Required</p>
        </div>
        <div style="background: rgba(0,0,0,0.02); padding: 1rem 1.5rem; border-top: 1px solid var(--border-soft);">
            <a href="/cycles/<%= cycleId %>/main-bill/new" style="color: var(--accent-orange); font-weight: 600; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; gap: 0.25rem;">Add / Edit <i data-lucide="chevron-right" style="width: 14px;"></i></a>
        </div>
    </div>

    <!-- Room Readings Card -->
    <div class="analytic-card" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
        <div style="padding: 1.5rem 1.5rem 0 1.5rem; display: flex; justify-content: space-between;">
            <h3 style="margin: 0;">Room Readings</h3>
            <span style="font-size: 0.75rem; background: rgba(174, 226, 194, 0.3); color: #047857; padding: 0.2rem 0.6rem; border-radius: 99px; font-weight: 600;">Collected</span>
        </div>
        <div style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center;">
            <!-- Simulating a progress bar or pie -->
            <div style="width: 100%; height: 8px; background: #EFEFEF; border-radius: 99px; margin-bottom: 1rem; overflow: hidden;">
                <div style="width: 100%; height: 100%; background: var(--accent-green-pastel);"></div>
            </div>
            <h2 style="font-size: 2rem; color: var(--text-main); line-height: 1; margin: 0;">100%</h2>
            <p style="color: var(--text-muted); font-size: 0.85rem; text-align: center; margin-top: 0.5rem;">All rooms logged</p>
        </div>
    </div>
</div>
