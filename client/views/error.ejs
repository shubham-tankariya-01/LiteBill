<% layout('layouts/boilerplate') %>

<% 
    const statusCode = error && error.status ? error.status : 500;
    const is404 = statusCode === 404;
    const icon = is404 ? 'link-2-off' : 'alert-triangle';
    const accentColor = is404 ? 'var(--accent-orange)' : 'var(--accent-red)';
    const title = is404 ? 'Page Not Found' : 'Something went wrong';
%>

<div style="display: flex; align-items: center; justify-content: center; min-height: 70vh; padding: 2rem;">
    <div style="text-align: center; position: relative; max-width: 600px; width: 100%;">
        
        <!-- Large background number -->
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 15rem; font-weight: 900; color: rgba(255,255,255,0.03); z-index: 0; user-select: none; pointer-events: none;">
            <%= statusCode %>
        </div>

        <div style="position: relative; z-index: 1;">
            <div style="width: 80px; height: 80px; background: rgba(255,255,255,0.02); border: 1px solid var(--border-soft); border-radius: 20px; display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem auto; box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
                <i data-lucide="<%= icon %>" style="width: 40px; height: 40px; color: <%= accentColor %>;"></i>
            </div>
            
            <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--text-primary); margin: 0 0 1rem 0; letter-spacing: -0.5px;">
                <%= title %>
            </h1>
            
            <p style="font-size: 1.1rem; color: var(--text-secondary); margin: 0 auto 2.5rem auto; line-height: 1.6; max-width: 80%;">
                <%= message || 'We encountered an unexpected error while processing your request.' %>
            </p>

            <% if (error && error.stack && process.env.NODE_ENV !== 'production') { %>
                <div style="background: rgba(0,0,0,0.3); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1.5rem; margin-bottom: 2.5rem; text-align: left; overflow-x: auto; position: relative; z-index: 10;">
                    <pre style="color: var(--text-muted); font-size: 0.85rem; margin: 0; font-family: monospace;"><%= error.stack %></pre>
                </div>
            <% } %>

            <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; position: relative; z-index: 10;">
                <button onclick="window.history.back()" class="btn btn-secondary" style="min-width: 150px;">
                    <i data-lucide="arrow-left" style="width: 16px;"></i> Go Back
                </button>
                <a href="/dashboard" class="btn btn-primary" style="background: var(--text-primary); color: var(--bg-body); min-width: 200px;">
                    Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
