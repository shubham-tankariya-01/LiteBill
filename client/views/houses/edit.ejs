<% layout('layouts/boilerplate') %>

<div class="container" style="max-width: 600px; margin: 0 auto;">
    <div class="analytic-card">
        <h2 style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="home" style="color: var(--accent-yellow);"></i> Edit House</h2>
        <p class="text-muted" style="margin-bottom: 2rem;">Update the property details.</p>

        <form action="/houses/<%= house._id %>?_method=PUT" method="POST">
            <div class="form-group">
                <label class="form-label" for="house_name">House Name</label>
                <input type="text" id="house_name" name="house_name" class="form-control" value="<%= house.house_name %>" required placeholder="e.g. Sunset Villa">
            </div>
            
            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">Save Changes</button>
                <a href="/houses/<%= house._id %>" class="btn btn-outline" style="flex: 1;">Cancel</a>
            </div>
        </form>
    </div>
</div>
