<% layout('layouts/boilerplate') %>

<div class="container" style="max-width: 580px; padding-top: 40px;">
    <div class="glass-card gradient-border-card">
        <div style="margin-bottom: 24px;">
            <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 8px; display: flex; align-items: center; gap: 12px;">
                <i data-lucide="edit-3" style="color: var(--accent-blue);"></i>
                <span>Edit Property Details</span>
            </h2>
            <p style="color: var(--text-secondary); font-size: 0.95rem;">Update the name or configuration of your property.</p>
        </div>

        <form action="/houses/<%= house._id %>?_method=PUT" method="POST">
            <div class="form-group" style="margin-bottom: 32px;">
                <label class="form-label" for="house_name" style="font-weight: 700;">Property Name</label>
                <input 
                    type="text" 
                    id="house_name" 
                    name="house_name" 
                    class="form-input" 
                    value="<%= house.house_name %>" 
                    required 
                    placeholder="e.g. Skyline Apartments"
                    style="min-height: 54px; font-size: 1rem;"
                >
            </div>
            
            <div style="display: flex; gap: 12px; margin-top: 8px;">
                <button type="submit" class="btn btn-primary" style="flex: 2; min-height: 54px; font-weight: 700;">
                    <span>Save Changes</span>
                    <i data-lucide="check-circle-2" style="width: 18px; height: 18px;"></i>
                </button>
                <a href="/houses/<%= house._id %>" class="btn btn-secondary" style="flex: 1; min-height: 54px; font-weight: 700;">Cancel</a>
            </div>
        </form>
    </div>
</div>
