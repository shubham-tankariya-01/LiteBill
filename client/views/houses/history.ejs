<% layout('layouts/boilerplate') %>

<!-- Header -->
<div style="margin-bottom: 2.5rem; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
    <div>
        <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.75rem; font-weight: 600; text-transform: uppercase;">
            <a href="/houses" style="color: var(--text-dim); text-decoration: none;">Properties</a> 
            <span>/</span> 
            <a href="/houses/<%= house._id %>" style="color: var(--text-dim); text-decoration: none;"><%= house.house_name %></a>
            <span>/</span>
            <span style="color: var(--accent-orange);">History</span>
        </div>
        <h1 style="margin: 0; display: flex; align-items: center; gap: 0.75rem; font-size: 2.25rem;">
            <i data-lucide="history" style="color: var(--accent-orange); width: 32px; height: 32px;"></i> Billing History
        </h1>
    </div>
    <a href="/houses/<%= house._id %>" class="btn btn-secondary"><i data-lucide="arrow-left"></i> Back to Dashboard</a>
</div>

<% if (cycles.length > 0) { %>
<!-- Summary Header Row -->
<div class="grid-3" style="margin-bottom: 2rem;">
    <div class="card-raised" style="display: flex; align-items: center; gap: 1.5rem; padding: 1.5rem;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(59, 130, 246, 0.1); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="bar-chart-2" style="color: var(--accent-blue);"></i>
        </div>
        <div>
            <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-secondary); font-weight: 700; margin-bottom: 0.25rem;">Total Cycles</div>
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);"><%= historySummary.totalCycles %></div>
        </div>
    </div>
    
    <div class="card-raised" style="display: flex; align-items: center; gap: 1.5rem; padding: 1.5rem;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(16, 185, 129, 0.1); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="indian-rupee" style="color: var(--accent-green);"></i>
        </div>
        <div>
            <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-secondary); font-weight: 700; margin-bottom: 0.25rem;">Total Amount Billed</div>
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);">₹<%= historySummary.totalBilled.toLocaleString() %></div>
        </div>
    </div>
    
    <div class="card-raised" style="display: flex; align-items: center; gap: 1.5rem; padding: 1.5rem;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(251, 191, 36, 0.1); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="calculator" style="color: var(--accent-yellow);"></i>
        </div>
        <div>
            <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-secondary); font-weight: 700; margin-bottom: 0.25rem;">Avg Bill / Cycle</div>
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);">₹<%= historySummary.avgBillAmount.toLocaleString(undefined, {maximumFractionDigits: 0}) %></div>
        </div>
    </div>
</div>

<!-- Search and Filter Bar -->
<div class="card-raised" style="margin-bottom: 2rem; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div style="position: relative; min-width: 250px; flex: 1;">
        <i data-lucide="search" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); width: 18px; color: var(--text-dim);"></i>
        <input type="text" id="historySearch" placeholder="Search by month or year..." class="form-input" style="padding-left: 2.75rem; background: var(--bg-body); border-color: var(--border-soft);">
    </div>
    
    <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
        <div class="filter-pills" style="display: flex; background: var(--bg-body); border: 1px solid var(--border-soft); border-radius: 8px; overflow: hidden; margin-right: 1rem;">
            <button class="filter-pill active" data-filter="all">All</button>
            <button class="filter-pill" data-filter="active">Active</button>
            <button class="filter-pill" data-filter="completed">Completed</button>
        </div>
        
        <select id="sortDropdown" class="form-input" style="width: auto; background: var(--bg-body); cursor: pointer;">
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="highest">Highest bill</option>
        </select>
    </div>
</div>
<% } %>

<!-- Cycle Cards Grid -->
<% if (cycles.length === 0) { %>
    <div class="card-raised" style="text-align: center; padding: 5rem 2rem; max-width: 600px; margin: 0 auto;">
        <div style="width: 80px; height: 80px; background: rgba(254, 138, 92, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
            <i data-lucide="history" style="width: 40px; height: 40px; color: var(--accent-orange);"></i>
        </div>
        <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem;">No History Found</h2>
        <p class="text-secondary" style="margin-bottom: 2rem; max-width: 400px; margin-left: auto; margin-right: auto;">
            Once you complete a billing cycle, its detailed invoice and distribution history will appear here.
        </p>
    </div>
<% } else { %>
    <div class="grid-layout" id="historyGrid" style="grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.5rem;">
        <% cycles.forEach((cycle) => { 
            const mainBill = mainBills.find(b => b.billing_cycle_id._id.toString() === cycle._id.toString());
            const isActive = !cycle.endDate;
            const statusClass = isActive ? 'status-active' : 'status-completed';
            
            const start = new Date(cycle.startDate);
            const end = cycle.endDate ? new Date(cycle.endDate) : new Date();
            const daysRunning = Math.max(1, Math.ceil((end - start) / (1000 * 60 * 60 * 24)));
            
            const startDateStr = start.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            const endDateStr = cycle.endDate ? new Date(cycle.endDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Present';
            
            const billAmount = mainBill ? mainBill.total_amount : 0;
            const stats = cycleStats[cycle._id.toString()] || { roomCount: 0, avgRoomAmount: 0 };
        %>
            <div class="card-raised history-card <%= statusClass %>" data-date="<%= start.getTime() %>" data-amount="<%= billAmount %>" style="display: flex; flex-direction: column; padding: 0; overflow: hidden; border-left: 4px solid <%= isActive ? 'var(--accent-green)' : 'var(--border)' %>;">
                
                <!-- Card Header -->
                <div style="padding: 1.5rem; border-bottom: 1px solid var(--border-soft); <%= isActive ? 'background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, transparent 100%);' : '' %>">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                        <span class="badge" style="background: <%= isActive ? 'rgba(16, 185, 129, 0.15)' : 'rgba(255,255,255,0.05)' %>; color: <%= isActive ? 'var(--accent-green)' : 'var(--text-secondary)' %>; font-weight: 700;">
                            <% if (isActive) { %>
                                <span style="display: inline-block; width: 6px; height: 6px; background: var(--accent-green); border-radius: 50%; margin-right: 4px; animation: pulse 2s infinite;"></span>
                            <% } else { %>
                                <span style="display: inline-block; width: 6px; height: 6px; background: var(--text-dim); border-radius: 50%; margin-right: 4px;"></span>
                            <% } %>
                            <%= isActive ? 'Active' : 'Completed' %>
                        </span>
                        
                        <div style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; display: flex; align-items: center; gap: 0.25rem;">
                            <i data-lucide="clock" style="width: 12px;"></i> <%= daysRunning %> Days
                        </div>
                    </div>
                    
                    <h3 class="cycle-title" style="margin: 0 0 0.25rem 0; font-size: 1.25rem; font-weight: 800; color: var(--text-primary);"><%= startDateStr %></h3>
                    <p style="margin: 0; color: var(--text-dim); font-size: 0.85rem;">to <%= endDateStr %></p>
                </div>

                <!-- Card Body -->
                <div style="padding: 1.5rem; flex-grow: 1;">
                    <% if (mainBill) { %>
                        <div style="display: flex; gap: 1.5rem; margin-bottom: 1.5rem;">
                            <div style="flex: 1;">
                                <div style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-secondary); font-weight: 700; margin-bottom: 0.25rem;">Bill Amount</div>
                                <div class="bill-amount" style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);">₹<%= billAmount.toLocaleString() %></div>
                            </div>
                            <div style="flex: 1; border-left: 1px solid var(--border-soft); padding-left: 1.5rem;">
                                <div style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-secondary); font-weight: 700; margin-bottom: 0.25rem;">Avg per Room</div>
                                <div style="font-size: 1.25rem; font-weight: 700; color: var(--accent-blue);">₹<%= Math.round(stats.avgRoomAmount).toLocaleString() %></div>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted);">
                            <i data-lucide="users" style="width: 14px;"></i> <%= stats.roomCount %> rooms billed
                        </div>
                    <% } else if (isActive) { %>
                        <div style="background: rgba(251, 191, 36, 0.1); padding: 1rem; border-radius: var(--radius-sm); border: 1px dashed rgba(251, 191, 36, 0.3);">
                            <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--accent-yellow); font-weight: 700; font-size: 0.85rem; margin-bottom: 0.25rem;">
                                <i data-lucide="file-input" style="width: 16px;"></i> Supplier Bill Required
                            </div>
                            <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary);">Enter the main bill to proceed.</p>
                        </div>
                    <% } else { %>
                        <div style="background: rgba(255,255,255,0.02); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-soft);">
                            <p style="margin: 0; font-size: 0.85rem; color: var(--text-secondary);">No bill data recorded for this cycle.</p>
                        </div>
                    <% } %>
                </div>

                <!-- Footer Action -->
                <div style="padding: 1rem 1.5rem; border-top: 1px solid var(--border-soft); background: rgba(255,255,255,0.01);">
                    <% if (isActive) { %>
                        <% if (!mainBill) { %>
                            <a href="/houses/<%= house._id %>/main-bill/new" class="btn btn-secondary" style="width: 100%; border-color: var(--accent-yellow); color: var(--accent-yellow);">Enter Supplier Bill &rarr;</a>
                        <% } else { %>
                            <a href="/houses/<%= house._id %>/cycles/<%= cycle._id %>/readings/new" class="btn btn-secondary" style="width: 100%; border-color: var(--accent-green); color: var(--accent-green);">Submit Readings &rarr;</a>
                        <% } %>
                    <% } else { %>
                        <a href="/cycles/<%= cycle._id %>/room-bills" class="btn btn-secondary" style="width: 100%;">View Distribution &rarr;</a>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>

<style>
    @keyframes pulse {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.5); opacity: 0.5; }
        100% { transform: scale(1); opacity: 1; }
    }
    
    .history-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .history-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    }
    
    .filter-pill {
        background: transparent;
        border: none;
        padding: 0.5rem 1rem;
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
    }
    .filter-pill:hover {
        color: var(--text-primary);
    }
    .filter-pill.active {
        background: var(--surface-raised);
        color: var(--text-primary);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('historySearch');
        const filterPills = document.querySelectorAll('.filter-pill');
        const sortDropdown = document.getElementById('sortDropdown');
        const grid = document.getElementById('historyGrid');
        
        if (!grid) return;
        
        let currentFilter = 'all';
        let currentSort = 'newest';
        
        function applyFilters() {
            const term = searchInput ? searchInput.value.toLowerCase() : '';
            const cards = Array.from(grid.querySelectorAll('.history-card'));
            
            cards.forEach(card => {
                const title = card.querySelector('.cycle-title').textContent.toLowerCase();
                const isMatchSearch = title.includes(term);
                
                const isMatchFilter = 
                    currentFilter === 'all' || 
                    (currentFilter === 'active' && card.classList.contains('status-active')) ||
                    (currentFilter === 'completed' && card.classList.contains('status-completed'));
                
                if (isMatchSearch && isMatchFilter) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
            
            // Apply sorting
            const visibleCards = cards.filter(c => c.style.display !== 'none');
            
            visibleCards.sort((a, b) => {
                if (currentSort === 'newest') {
                    return parseFloat(b.dataset.date) - parseFloat(a.dataset.date);
                } else if (currentSort === 'oldest') {
                    return parseFloat(a.dataset.date) - parseFloat(b.dataset.date);
                } else if (currentSort === 'highest') {
                    return parseFloat(b.dataset.amount) - parseFloat(a.dataset.amount);
                }
            });
            
            visibleCards.forEach(card => grid.appendChild(card));
        }
        
        if (searchInput) {
            searchInput.addEventListener('input', applyFilters);
        }
        
        filterPills.forEach(pill => {
            pill.addEventListener('click', (e) => {
                filterPills.forEach(p => p.classList.remove('active'));
                e.target.classList.add('active');
                currentFilter = e.target.dataset.filter;
                applyFilters();
            });
        });
        
        if (sortDropdown) {
            sortDropdown.addEventListener('change', (e) => {
                currentSort = e.target.value;
                applyFilters();
            });
        }
    });
</script>
