<% layout('layouts/boilerplate') %>

<div class="page-header sticky-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 1rem;">
        <h1 style="margin: 0; display: flex; align-items: center; gap: 0.5rem;">
            <i data-lucide="home" style="color: var(--accent-yellow);"></i> My Properties
        </h1>
        <span class="badge badge-dim"><%= houses.length %> Total</span>
    </div>
    <a href="/houses/new" class="btn btn-primary"><i data-lucide="plus"></i> Add Property</a>
</div>

<% if (houses.length === 0) { %>
    <%- include('../includes/empty_state', {
        icon: 'home',
        title: 'Add your first property',
        description: 'Get started by adding a property to manage meters, automatically split utility bills, and track payment history.',
        ctaText: 'Create Property',
        ctaLink: '/houses/new',
        ctaIcon: 'plus'
    }) %>
<% } else { %>
    <div class="grid-2">
        <% houses.forEach(house => { 
            const status = houseStatuses[house._id.toString()];
            const formattedDate = status.lastBillDate ? new Date(status.lastBillDate).toLocaleDateString() : 'Never';
            
            // Derive a cycle day if lastBillDate exists (rough estimate)
            let cycleDayText = 'Not started';
            let progressWidth = '0%';
            if (status.lastBillDate) {
                const diffTime = Math.abs(new Date() - new Date(status.lastBillDate));
                const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
                cycleDayText = `Day ${diffDays}`;
                progressWidth = `${Math.min((diffDays / 30) * 100, 100)}%`;
            } else if (status.hasSetup && !status.hasBillThisCycle) {
                cycleDayText = `Cycle active`;
                progressWidth = `50%`; // Arbitrary visual feedback for active but no bill
            }

            let statusBadge = '<span class="badge badge-dim">Not Set Up</span>';
            if (status.hasSetup) {
                if (!status.hasBillThisCycle) statusBadge = '<span class="badge badge-orange">Awaiting Bill</span>';
                else statusBadge = '<span class="badge badge-green">Active</span>';
            }
        %>
            <div class="card-raised card-accent house-card" style="--card-accent-color: var(--accent-yellow); display: flex; flex-direction: column;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                    <h3 style="margin: 0; color: var(--text-primary); font-size: 1.25rem; font-weight: 700;">
                        <%= house.house_name %>
                    </h3>
                    <%- statusBadge %>
                </div>
                
                <div style="color: var(--text-secondary); font-size: 0.9rem; font-weight: 500; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                    <i data-lucide="bed-double" style="width: 14px;"></i> <%= status.roomCount %> rooms 
                    <span style="color: var(--border);">•</span> 
                    <i data-lucide="calendar" style="width: 14px;"></i> Last billed: <%= formattedDate %>
                    <span style="color: var(--border);">•</span> 
                    <%= cycleDayText %>
                </div>
                
                <div style="margin-bottom: 1.5rem;">
                    <div style="height: 6px; background: var(--surface); border-radius: 3px; overflow: hidden; width: 100%;">
                        <div style="height: 100%; width: <%= progressWidth %>; background: var(--accent-yellow); border-radius: 3px;"></div>
                    </div>
                </div>
                
                <div style="display: flex; gap: 0.75rem; margin-top: auto;">
                    <a href="/houses/<%= house._id %>" class="btn btn-secondary" style="flex: 1; border-color: var(--border); color: var(--text-primary);">Open Dashboard</a>
                    <a href="/houses/<%= house._id %>/edit" class="btn btn-icon btn-ghost"><i data-lucide="settings-2"></i></a>
                    <button type="button" class="btn btn-icon btn-ghost" style="color: var(--accent-red);" onclick="openDeleteHouseModal('<%= house._id %>', '<%= house.house_name %>')">
                        <i data-lucide="trash-2"></i>
                    </button>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>

<style>
    .house-card {
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .house-card:hover {
        transform: translateY(-2px);
        border-color: var(--accent-yellow);
        box-shadow: 0 10px 30px rgba(0,0,0,0.6);
    }
</style>