<% layout('layouts/boilerplate') %>

<%
    let cycleStartDateStr = 'Not Started';
    let daysElapsed = 0;
    let progressPct = 0;

    if (activeCycle && activeCycle.startDate) {
        cycleStartDateStr = new Date(activeCycle.startDate).toLocaleDateString('en-IN', {
            month: 'short',
            day: 'numeric',
            year: 'numeric'
        });
        const diffTime = Math.abs(new Date() - new Date(activeCycle.startDate));
        daysElapsed = Math.floor(diffTime / (1000 * 60 * 60 * 24));
        progressPct = Math.min((daysElapsed / 30) * 100, 100);
    }

    let statusBadgeClass = 'badge-dim';
    let statusBadgeText = 'Not Set Up';
    let flowIcon = 'wrench';
    let flowTitle = 'Initial Setup Required';
    let flowDesc = 'Configure the opening readings so this property can begin its first billing cycle.';
    let flowBtn = 'Setup Meters';
    let flowLink = `/houses/${house._id}/readings/new`;
    let heroPatternClass = 'hero-pattern-setup';

    if (flowState === 'needs_bill') {
        statusBadgeClass = 'badge-orange';
        statusBadgeText = 'Awaiting Bill';
        flowIcon = 'receipt';
        flowTitle = 'Enter the Main Bill';
        flowDesc = 'Add the supplier bill for this cycle before room readings and final allocations can continue.';
        flowBtn = 'Enter Main Bill';
        flowLink = `/houses/${house._id}/main-bill/new`;
        heroPatternClass = 'hero-pattern-bill';
    } else if (flowState === 'needs_readings') {
        statusBadgeClass = 'badge-blue';
        statusBadgeText = 'Awaiting Readings';
        flowIcon = 'zap';
        flowTitle = 'Record Room Readings';
        flowDesc = 'Capture the latest room meter readings to finalize this cycle and generate the latest bills.';
        flowBtn = 'Submit Readings';
        flowLink = `/houses/${house._id}/readings/new`;
        heroPatternClass = 'hero-pattern-readings';
    } else if (flowState === 'cycle_complete') {
        statusBadgeClass = 'badge-green';
        statusBadgeText = 'Cycle Complete';
        flowIcon = 'check-circle-2';
        flowTitle = 'Cycle Finalized';
        flowDesc = 'This cycle has been completed. Review the generated room bills and recent billing history.';
        flowBtn = 'View Room Bills';
        flowLink = activeCycle ? `/cycles/${activeCycle._id}/room-bills` : `/houses/${house._id}/history`;
        heroPatternClass = 'hero-pattern-complete';
    }
%>

<div class="house-breadcrumb">Properties / <span><%= house.house_name %></span></div>

<section class="page-header house-header">
    <div>
        <h1 class="house-title">
            <i data-lucide="home"></i>
            <span><%= house.house_name %></span>
        </h1>
    </div>

    <div class="house-header-actions">
        <a href="/houses/<%= house._id %>/edit" class="btn btn-ghost">
            <i data-lucide="settings-2" style="width: 18px; height: 18px;"></i>
            <span>Edit</span>
        </a>
        <button type="button" class="house-delete-btn" aria-label="Delete property" onclick="openDeleteHouseModal('<%= house._id %>', '<%= house.house_name %>')">
            <i data-lucide="trash-2"></i>
        </button>
    </div>
</section>

<section class="card house-cycle-status">
    <div class="house-cycle-col">
        <div class="eyebrow" style="margin-bottom: 8px;">Cycle Started</div>
        <div class="house-cycle-value"><%= cycleStartDateStr %></div>
    </div>

    <div class="house-cycle-progress">
        <div class="house-cycle-progress-head">
            <span>Day <%= daysElapsed %></span>
            <span>~30 days</span>
        </div>
        <div class="progress-bar-wrap">
            <div class="progress-bar-fill" style="width: <%= progressPct %>%; background: #FF6B2B;"></div>
        </div>
    </div>

    <div class="house-cycle-col house-cycle-status-pill">
        <span class="badge <%= statusBadgeClass %> house-status-badge"><%= statusBadgeText %></span>
    </div>
</section>

<section class="house-hero-card <%= heroPatternClass %>">
    <div class="house-hero-copy">
        <div class="house-hero-icon">
            <i data-lucide="<%= flowIcon %>"></i>
        </div>
        <div>
            <h2><%= flowTitle %></h2>
            <p><%= flowDesc %></p>
        </div>
    </div>

    <a href="<%= flowLink %>" class="house-hero-cta"><%= flowBtn %> -&gt;</a>
</section>

<section class="grid-3 house-info-grid">
    <article class="card house-info-card">
        <div class="house-info-top">
            <div class="house-info-title-wrap">
                <i data-lucide="bed-double" style="color: #8B5CF6;"></i>
                <div class="section-title">Meters Configured</div>
            </div>
            <div class="house-info-count"><%= rooms.length %></div>
        </div>

        <p class="house-info-desc">Review configured room meters, add new ones, and keep this property ready for the next cycle.</p>

        <div class="house-info-actions">
            <a href="/houses/<%= house._id %>/rooms" class="btn btn-secondary house-info-main-btn">View All -&gt;</a>
            <a href="/houses/<%= house._id %>/rooms/new" class="house-info-icon-btn" aria-label="Add room">
                <i data-lucide="plus"></i>
            </a>
        </div>
    </article>

    <article class="card house-info-card">
        <div class="house-info-top">
            <div class="house-info-title-wrap">
                <i data-lucide="calendar-clock" style="color: #5B8DEF;"></i>
                <div class="section-title">Billing Cycles</div>
            </div>
        </div>

        <div class="house-billing-body">
            <div class="eyebrow" style="margin-bottom: 8px;">Active Period</div>
            <div class="house-cycle-running"><%= activeCycle ? 'Currently Running' : 'None Active' %></div>
        </div>

        <div class="house-info-actions">
            <a href="/houses/<%= house._id %>/history" class="btn btn-secondary house-info-main-btn">View History -&gt;</a>
        </div>
    </article>

    <article class="card house-info-card">
        <div class="house-info-top">
            <div class="house-info-title-wrap">
                <i data-lucide="history" style="color: #4CAF7D;"></i>
                <div class="section-title">Recent Bills</div>
            </div>
        </div>

        <% if (typeof recentMainBills !== 'undefined' && recentMainBills.length > 0) { %>
            <div class="house-bills-list">
                <% recentMainBills.slice(0, 3).forEach((bill, index) => { %>
                    <div class="house-bill-row <%= index !== Math.min(recentMainBills.length, 3) - 1 ? 'has-divider' : '' %>">
                        <span><%= new Date(bill.bill_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                        <strong>₹<%= Number(bill.total_amount || 0).toLocaleString('en-IN') %></strong>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p class="house-bills-empty">No completed cycles found.</p>
        <% } %>
    </article>
</section>

<style>
    .house-breadcrumb {
        margin-bottom: 14px;
        color: #7A7A8A;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .house-breadcrumb span {
        color: #1A1A1A;
    }

    .house-header {
        margin-bottom: 20px;
    }

    .house-title {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 1.75rem;
        font-weight: 800;
        line-height: 1.1;
    }

    .house-title i {
        width: 24px;
        height: 24px;
        color: #FF6B2B;
    }

    .house-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .house-delete-btn {
        width: 48px;
        height: 48px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #7A7A8A;
        background: transparent;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .house-delete-btn:hover {
        background: #FFF0E6;
        color: #EF4444;
    }

    .house-delete-btn i {
        width: 18px;
        height: 18px;
    }

    .house-cycle-status {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }

    .house-cycle-col {
        flex: 1;
        min-width: 0;
    }

    .house-cycle-value {
        font-size: 1.2rem;
        font-weight: 700;
        color: #1A1A1A;
    }

    .house-cycle-progress {
        flex: 1.4;
        min-width: 240px;
    }

    .house-cycle-progress-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 8px;
        color: #7A7A8A;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .house-cycle-status-pill {
        display: flex;
        justify-content: flex-end;
    }

    .house-status-badge {
        min-height: 40px;
        padding: 8px 16px;
        font-size: 0.82rem;
    }

    .house-hero-card {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 20px;
        padding: 28px;
        border-radius: 20px;
        background: #1F1F1F;
    }

    .house-hero-card::before {
        content: '';
        position: absolute;
        inset: 0;
        opacity: 0.12;
        pointer-events: none;
    }

    .hero-pattern-setup::before {
        background:
            radial-gradient(circle at 16% 24%, #FF6B2B 0, transparent 22%),
            linear-gradient(120deg, transparent 0 62%, rgba(255,255,255,0.2) 62% 64%, transparent 64%);
    }

    .hero-pattern-bill::before {
        background:
            linear-gradient(135deg, rgba(255,255,255,0.14) 0 8%, transparent 8% 100%),
            radial-gradient(circle at 84% 30%, #FF6B2B 0, transparent 20%);
    }

    .hero-pattern-readings::before {
        background:
            radial-gradient(circle at 80% 20%, #5B8DEF 0, transparent 18%),
            linear-gradient(90deg, transparent 0 72%, rgba(255,255,255,0.18) 72% 74%, transparent 74%);
    }

    .hero-pattern-complete::before {
        background:
            radial-gradient(circle at 18% 78%, #4CAF7D 0, transparent 18%),
            linear-gradient(135deg, transparent 0 68%, rgba(255,255,255,0.15) 68% 70%, transparent 70%);
    }

    .house-hero-copy,
    .house-hero-cta {
        position: relative;
        z-index: 1;
    }

    .house-hero-copy {
        display: flex;
        align-items: flex-start;
        gap: 18px;
        min-width: 0;
    }

    .house-hero-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: #FFFFFF;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .house-hero-icon i {
        width: 26px;
        height: 26px;
        color: #1A1A1A;
    }

    .house-hero-copy h2 {
        margin-bottom: 8px;
        color: #FFFFFF;
        font-size: 1.35rem;
        font-weight: 800;
    }

    .house-hero-copy p {
        color: #A0A0B0;
        max-width: 620px;
        font-size: 0.92rem;
    }

    .house-hero-cta {
        min-height: 48px;
        padding: 0 20px;
        border-radius: 999px;
        background: #FFFFFF;
        color: #1A1A1A;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
    }

    .house-info-grid {
        gap: 20px;
    }

    .house-info-card {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .house-info-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
    }

    .house-info-title-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .house-info-title-wrap i {
        width: 20px;
        height: 20px;
    }

    .house-info-count {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1;
        color: #1A1A1A;
    }

    .house-info-desc,
    .house-bills-empty {
        color: #7A7A8A;
        font-size: 0.88rem;
        line-height: 1.5;
    }

    .house-info-actions {
        margin-top: auto;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .house-info-main-btn {
        flex: 1;
    }

    .house-info-icon-btn {
        width: 44px;
        height: 44px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #7A7A8A;
        background: transparent;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .house-info-icon-btn:hover {
        background: #F7F6F2;
        color: #1A1A1A;
    }

    .house-info-icon-btn i {
        width: 18px;
        height: 18px;
    }

    .house-billing-body {
        min-height: 74px;
    }

    .house-cycle-running {
        font-size: 1rem;
        font-weight: 700;
        color: #1A1A1A;
    }

    .house-bills-list {
        display: flex;
        flex-direction: column;
    }

    .house-bill-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 12px 0;
        color: #7A7A8A;
        font-size: 0.88rem;
    }

    .house-bill-row.has-divider {
        border-bottom: 1px solid #F0EFE9;
    }

    .house-bill-row strong {
        color: #2E7D52;
        font-weight: 700;
        white-space: nowrap;
    }

    @media (max-width: 768px) {
        .house-header-actions {
            width: 100%;
        }

        .house-header-actions .btn {
            flex: 1;
        }

        .house-cycle-status,
        .house-hero-card {
            flex-direction: column;
            align-items: stretch;
        }

        .house-cycle-progress {
            min-width: 0;
        }

        .house-cycle-status-pill {
            justify-content: flex-start;
        }

        .house-hero-cta {
            width: 100%;
        }
    }
</style>
