<div class="card-raised empty-state" style="padding: 48px 24px; max-width: 640px; margin: 0 auto;">
    <div style="width: 72px; height: 72px; background: var(--surface-raised); border-radius: 20px; display: flex; align-items: center; justify-content: center;">
        <i data-lucide="<%= typeof icon !== 'undefined' ? icon : 'inbox' %>" style="width: 28px; height: 28px; color: var(--accent-orange);"></i>
    </div>

    <div class="eyebrow">Nothing Here Yet</div>

    <h3 style="font-size: 1.25rem; margin: 0;">
        <%= typeof title !== 'undefined' ? title : 'No items found' %>
    </h3>

    <p class="text-muted" style="max-width: 460px;">
        <%= typeof description !== 'undefined' ? description : 'There is currently no data to display here.' %>
    </p>

    <% if (typeof ctaText !== 'undefined') { %>
        <% if (typeof ctaLink !== 'undefined') { %>
            <a href="<%= ctaLink %>" class="btn <%= typeof ctaClass !== 'undefined' ? ctaClass : 'btn-primary' %>">
                <% if (typeof ctaIcon !== 'undefined') { %>
                    <i data-lucide="<%= ctaIcon %>" style="width: 16px; height: 16px;"></i>
                <% } %>
                <%= ctaText %>
            </a>
        <% } else if (typeof ctaAction !== 'undefined') { %>
            <button onclick="<%= ctaAction %>" class="btn <%= typeof ctaClass !== 'undefined' ? ctaClass : 'btn-primary' %>">
                <% if (typeof ctaIcon !== 'undefined') { %>
                    <i data-lucide="<%= ctaIcon %>" style="width: 16px; height: 16px;"></i>
                <% } %>
                <%= ctaText %>
            </button>
        <% } %>
    <% } %>
</div>
