<%
    const pathValue = typeof currentPath !== 'undefined' ? currentPath : '';
    const houses = typeof navHouses !== 'undefined' ? navHouses : [];
    const firstHouse = houses.length > 0 ? houses[0] : null;
    const userInitial = (typeof user !== 'undefined' && user.mobile_number) ? user.mobile_number[0] : 'U';
    const hasNotifications = false;

    const isDashboard = pathValue === '/dashboard';
    const isProperties = pathValue.startsWith('/houses') && !pathValue.includes('/history') && !pathValue.includes('/cycles') && !pathValue.includes('/readings') && !pathValue.includes('/main-bill');
    const isBilling = pathValue.includes('/readings') || pathValue.includes('/main-bill') || pathValue.includes('/cycles');
    const isHistory = pathValue.includes('/history');
%>

<nav class="litebill-navbar">
    <div class="litebill-navbar-inner">
        <a href="/dashboard" class="litebill-logo-pill" aria-label="LiteBill dashboard">
            <i data-lucide="zap"></i>
            <span>LiteBill</span>
        </a>

        <div class="litebill-nav-center desktop-only">
            <div class="litebill-nav-pills">
                <a href="/dashboard" class="litebill-nav-pill <%= isDashboard ? 'active' : '' %>">Dashboard</a>

                <div class="litebill-dropdown-wrap">
                    <button type="button" id="propertiesMenuButton" class="litebill-nav-pill <%= isProperties ? 'active' : '' %>">
                        <span>Properties</span>
                        <i data-lucide="chevron-down"></i>
                    </button>
                    <div id="propertiesMenu" class="litebill-dropdown-menu hidden">
                        <a href="/houses" class="litebill-dropdown-item"><i data-lucide="layout-grid"></i> All Properties</a>
                        <a href="/houses/new" class="litebill-dropdown-item"><i data-lucide="plus"></i> Add Property</a>
                        <div class="litebill-dropdown-divider"></div>
                        <div class="litebill-dropdown-section-title">Your Houses</div>
                        <% if (houses.length > 0) { %>
                            <% houses.slice(0, 5).forEach((house) => { %>
                                <a href="/houses/<%= house._id %>" class="litebill-dropdown-item">
                                    <i data-lucide="house"></i>
                                    <span><%= house.house_name %></span>
                                </a>
                            <% }) %>
                        <% } else { %>
                            <div class="litebill-dropdown-empty">No properties yet</div>
                        <% } %>
                    </div>
                </div>

                <div class="litebill-dropdown-wrap">
                    <button type="button" id="billingMenuButton" class="litebill-nav-pill <%= isBilling ? 'active' : '' %>">
                        <span>Billing</span>
                        <i data-lucide="chevron-down"></i>
                    </button>
                    <div id="billingMenu" class="litebill-dropdown-menu hidden">
                        <% if (firstHouse) { %>
                            <a href="/houses/<%= firstHouse._id %>/readings/new" class="litebill-dropdown-item"><i data-lucide="clipboard-pen-line"></i> Submit Readings</a>
                            <a href="/houses/<%= firstHouse._id %>/main-bill/new" class="litebill-dropdown-item"><i data-lucide="receipt"></i> Enter Main Bill</a>
                            <a href="/houses/<%= firstHouse._id %>/cycles" class="litebill-dropdown-item"><i data-lucide="calendar-clock"></i> View Cycles</a>
                        <% } else { %>
                            <a href="/houses" class="litebill-dropdown-item"><i data-lucide="home-plus"></i> Add a property first</a>
                        <% } %>
                    </div>
                </div>

                <div class="litebill-dropdown-wrap">
                    <button type="button" id="historyMenuButton" class="litebill-nav-pill <%= isHistory ? 'active' : '' %>">
                        <span>History</span>
                        <i data-lucide="chevron-down"></i>
                    </button>
                    <div id="historyMenu" class="litebill-dropdown-menu hidden">
                        <% if (houses.length > 0) { %>
                            <% houses.forEach((house) => { %>
                                <a href="/houses/<%= house._id %>/history" class="litebill-dropdown-item">
                                    <i data-lucide="history"></i>
                                    <span><%= house.house_name %></span>
                                </a>
                            <% }) %>
                        <% } else { %>
                            <a href="/houses/new" class="litebill-dropdown-item"><i data-lucide="plus"></i> Add a property first</a>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <div class="litebill-nav-right desktop-only">
            <button type="button" id="openCommandPalette" class="litebill-icon-button" aria-label="Open search">
                <i data-lucide="search"></i>
            </button>

            <button type="button" class="litebill-icon-button litebill-bell-button" aria-label="Notifications">
                <i data-lucide="bell"></i>
                <% if (hasNotifications) { %>
                    <span class="litebill-notification-dot"></span>
                <% } %>
            </button>

            <div class="litebill-dropdown-wrap">
                <button type="button" id="userMenuButton" class="litebill-avatar-pill" aria-label="Open user menu">
                    <span><%= userInitial %></span>
                </button>
                <div id="userMenu" class="litebill-dropdown-menu litebill-dropdown-menu-right hidden">
                    <a href="/auth/profile" class="litebill-dropdown-item"><i data-lucide="user"></i> My Profile</a>
                    <a href="/auth/profile" class="litebill-dropdown-item"><i data-lucide="lock"></i> Change Password</a>
                    <div class="litebill-dropdown-divider"></div>
                    <form action="/auth/logout" method="POST" style="margin: 0;">
                        <button type="submit" class="litebill-dropdown-item litebill-dropdown-item-danger" style="width: 100%; text-align: left;">
                            <i data-lucide="log-out"></i>
                            <span>Sign Out</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="mobile-only litebill-mobile-actions">
            <button type="button" id="openMobileDrawer" class="litebill-icon-button litebill-hamburger-button" aria-label="Open menu">
                <i data-lucide="menu"></i>
            </button>
        </div>
    </div>
</nav>

<div id="commandPalette" class="litebill-command-palette hidden">
    <div id="commandPaletteBackdrop" class="litebill-command-backdrop"></div>
    <div class="litebill-command-card">
        <div class="litebill-command-input-wrap">
            <i data-lucide="search"></i>
            <input id="commandPaletteInput" type="text" class="litebill-command-input" placeholder="Search houses, pages, billing flows..." />
            <span class="litebill-command-kbd">ESC</span>
        </div>
        <div class="litebill-command-body">
            <div class="litebill-command-section">
                <div class="litebill-dropdown-section-title">Quick Links</div>
                <a href="/dashboard" class="litebill-dropdown-item"><i data-lucide="layout-dashboard"></i> Dashboard</a>
                <a href="/houses" class="litebill-dropdown-item"><i data-lucide="layout-grid"></i> All Properties</a>
                <a href="/houses/new" class="litebill-dropdown-item"><i data-lucide="plus"></i> Add Property</a>
            </div>
            <div class="litebill-command-section">
                <div class="litebill-dropdown-section-title">Your Houses</div>
                <% if (houses.length > 0) { %>
                    <% houses.forEach((house) => { %>
                        <a href="/houses/<%= house._id %>" class="litebill-dropdown-item">
                            <i data-lucide="house"></i>
                            <span><%= house.house_name %></span>
                        </a>
                    <% }) %>
                <% } else { %>
                    <div class="litebill-dropdown-empty">No properties yet</div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<div id="mobileDrawer" class="litebill-mobile-overlay hidden">
    <div id="mobileDrawerBackdrop" class="litebill-mobile-backdrop"></div>
    <div class="litebill-mobile-drawer">
        <div class="litebill-mobile-drawer-header">
            <a href="/dashboard" class="litebill-logo-pill litebill-logo-pill-mobile">
                <i data-lucide="zap"></i>
                <span>LiteBill</span>
            </a>
            <button type="button" id="closeMobileDrawer" class="litebill-icon-button" aria-label="Close menu">
                <i data-lucide="x"></i>
            </button>
        </div>

        <div class="litebill-mobile-links">
            <a href="/dashboard" class="litebill-mobile-link <%= isDashboard ? 'active' : '' %>">Dashboard</a>
            <a href="/houses" class="litebill-mobile-link <%= isProperties ? 'active' : '' %>">Properties</a>
            <a href="<%= firstHouse ? '/houses/' + firstHouse._id + '/cycles' : '/houses' %>" class="litebill-mobile-link <%= isBilling ? 'active' : '' %>">Billing</a>
            <a href="<%= firstHouse ? '/houses/' + firstHouse._id + '/history' : '/houses' %>" class="litebill-mobile-link <%= isHistory ? 'active' : '' %>">History</a>
            <a href="/auth/profile" class="litebill-mobile-link">Profile</a>
            <form action="/auth/logout" method="POST" style="margin: 0;">
                <button type="submit" class="litebill-mobile-link litebill-mobile-link-danger">Sign Out</button>
            </form>
        </div>
    </div>
</div>

<style>
    .litebill-navbar {
        position: sticky;
        top: 0;
        z-index: 1500;
        height: var(--navbar-height);
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        border-bottom: 1px solid var(--glass-border);
        box-shadow: 0 4px 24px -1px rgba(0, 0, 0, 0.03);
    }

    .litebill-navbar-inner {
        max-width: 1300px;
        height: 100%;
        margin: 0 auto;
        padding: 0 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .litebill-logo-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
        padding: 0 16px;
        border-radius: 999px;
        background: var(--surface-dark);
        color: var(--text-on-dark);
        font-weight: 800;
        flex-shrink: 0;
    }

    .litebill-logo-pill i {
        width: 18px;
        height: 18px;
        color: var(--accent-orange);
    }

    .litebill-nav-center {
        flex: 1;
        justify-content: center;
    }

    .litebill-nav-pills {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px;
        background: var(--surface-soft);
        border-radius: 999px;
    }

    .litebill-nav-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 46px;
        padding: 0 22px;
        border-radius: 999px;
        color: var(--text-secondary);
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }

    .litebill-nav-pill i {
        width: 14px;
        height: 14px;
    }

    .litebill-nav-pill:hover,
    .litebill-nav-pill.active {
        background: var(--surface-dark);
        color: var(--text-on-dark);
    }

    .litebill-nav-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .litebill-icon-button {
        position: relative;
        width: 48px;
        min-width: 48px;
        height: 48px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #7A7A8A;
        transition: background 0.2s ease, color 0.2s ease;
        cursor: pointer;
    }

    .litebill-icon-button:hover {
        background: #F7F6F2;
        color: #1A1A1A;
    }

    .litebill-icon-button i {
        width: 18px;
        height: 18px;
    }

    .litebill-bell-button {
        overflow: visible;
    }

    .litebill-notification-dot {
        position: absolute;
        top: 11px;
        right: 12px;
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--accent-orange);
    }

    .litebill-avatar-pill {
        width: 44px;
        height: 44px;
        border-radius: 999px;
        background: var(--surface-dark);
        color: var(--text-on-dark);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        cursor: pointer;
    }

    .litebill-dropdown-wrap {
        position: relative;
    }

    .litebill-dropdown-menu {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        min-width: 240px;
        padding: 8px;
        background: #FFFFFF;
        border-radius: 16px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
        z-index: 1600;
    }

    .litebill-dropdown-menu-right {
        right: 0;
        left: auto;
    }

    .litebill-dropdown-item {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 40px;
        padding: 10px 12px;
        border-radius: 12px;
        color: #1A1A1A;
        font-size: 0.9rem;
    }

    .litebill-dropdown-item:hover {
        background: #F7F6F2;
    }

    .litebill-dropdown-item i {
        width: 18px;
        height: 18px;
        color: #7A7A8A;
    }

    .litebill-dropdown-item-danger,
    .litebill-dropdown-item-danger i {
        color: #CC4A0C;
    }

    .litebill-dropdown-divider {
        height: 1px;
        background: #F0EFE9;
        margin: 8px 0;
    }

    .litebill-dropdown-section-title {
        padding: 8px 12px;
        color: #7A7A8A;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .litebill-dropdown-empty {
        padding: 12px;
        color: #7A7A8A;
        font-size: 0.85rem;
    }

    .litebill-command-palette {
        position: fixed;
        inset: 0;
        z-index: 1800;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 80px 16px 24px;
    }

    .litebill-command-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
    }

    .litebill-command-card {
        position: relative;
        width: 100%;
        max-width: 600px;
        background: #FFFFFF;
        border-radius: 24px;
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.14);
        overflow: hidden;
    }

    .litebill-command-input-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 18px 20px;
        border-bottom: 1px solid #F0EFE9;
    }

    .litebill-command-input-wrap i {
        width: 18px;
        height: 18px;
        color: #7A7A8A;
    }

    .litebill-command-input {
        flex: 1;
        min-height: auto;
        padding: 0;
        background: transparent;
        border: none;
        outline: none;
        color: #1A1A1A;
        font-size: 0.95rem;
    }

    .litebill-command-kbd {
        padding: 4px 10px;
        border-radius: 999px;
        background: #F2F1EC;
        color: #7A7A8A;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .litebill-command-body {
        max-height: 420px;
        overflow-y: auto;
        padding: 8px;
    }

    .litebill-command-section + .litebill-command-section {
        margin-top: 8px;
    }

    .litebill-mobile-actions {
        align-items: center;
    }

    .litebill-hamburger-button {
        color: #1A1A1A;
    }

    .litebill-mobile-overlay {
        position: fixed;
        inset: 0;
        z-index: 1700;
    }

    .litebill-mobile-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
    }

    .litebill-mobile-drawer {
        position: absolute;
        top: 0;
        left: 0;
        width: 80%;
        max-width: 300px;
        height: 100%;
        background: #FFFFFF;
        transform: translateX(-100%);
        transition: transform 0.24s ease;
        display: flex;
        flex-direction: column;
    }

    .litebill-mobile-overlay.open .litebill-mobile-drawer {
        transform: translateX(0);
    }

    .litebill-mobile-drawer-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px;
        border-bottom: 1px solid #F0EFE9;
    }

    .litebill-logo-pill-mobile {
        min-height: 40px;
    }

    .litebill-mobile-links {
        display: flex;
        flex-direction: column;
    }

    .litebill-mobile-link {
        display: flex;
        align-items: center;
        width: 100%;
        min-height: 56px;
        padding: 0 16px;
        border-bottom: 1px solid #F0EFE9;
        color: #1A1A1A;
        font-weight: 500;
        text-align: left;
    }

    .litebill-mobile-link.active {
        background: #F7F6F2;
        font-weight: 700;
    }

    .litebill-mobile-link-danger {
        color: #CC4A0C;
    }

    @media (max-width: 768px) {
        .litebill-navbar-inner {
            padding: 0 16px;
        }

        .litebill-nav-center,
        .litebill-nav-right {
            display: none !important;
        }

        .litebill-mobile-actions {
            display: inline-flex;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const dropdownPairs = [
            ["propertiesMenuButton", "propertiesMenu"],
            ["billingMenuButton", "billingMenu"],
            ["historyMenuButton", "historyMenu"],
            ["userMenuButton", "userMenu"]
        ];

        const commandPalette = document.getElementById("commandPalette");
        const commandBackdrop = document.getElementById("commandPaletteBackdrop");
        const commandInput = document.getElementById("commandPaletteInput");
        const searchTrigger = document.getElementById("openCommandPalette");

        const mobileOverlay = document.getElementById("mobileDrawer");
        const mobileBackdrop = document.getElementById("mobileDrawerBackdrop");
        const mobileOpen = document.getElementById("openMobileDrawer");
        const mobileClose = document.getElementById("closeMobileDrawer");

        const closeAllDropdowns = () => {
            dropdownPairs.forEach(([, menuId]) => {
                const menu = document.getElementById(menuId);
                if (menu) menu.classList.add("hidden");
            });
        };

        dropdownPairs.forEach(([buttonId, menuId]) => {
            const button = document.getElementById(buttonId);
            const menu = document.getElementById(menuId);
            if (!button || !menu) return;

            button.addEventListener("click", (event) => {
                event.preventDefault();
                event.stopPropagation();
                const isHidden = menu.classList.contains("hidden");
                closeAllDropdowns();
                if (isHidden) menu.classList.remove("hidden");
            });
        });

        document.addEventListener("click", (event) => {
            if (!event.target.closest(".litebill-dropdown-wrap")) {
                closeAllDropdowns();
            }
        });

        const openCommandPalette = () => {
            commandPalette?.classList.remove("hidden");
            document.body.classList.add("modal-open");
            setTimeout(() => commandInput?.focus(), 20);
        };

        const closeCommandPalette = () => {
            commandPalette?.classList.add("hidden");
            document.body.classList.remove("modal-open");
            if (commandInput) {
                commandInput.value = "";
                commandInput.dispatchEvent(new Event("input"));
            }
        };

        commandInput?.addEventListener("input", (e) => {
            const query = e.target.value.toLowerCase().trim();
            const sections = document.querySelectorAll(".litebill-command-section");
            sections.forEach(section => {
                const items = section.querySelectorAll(".litebill-dropdown-item");
                let visibleCount = 0;
                items.forEach(item => {
                    const text = item.textContent.toLowerCase();
                    if (text.includes(query)) {
                        item.style.display = "";
                        visibleCount++;
                    } else {
                        item.style.display = "none";
                    }
                });
                if (visibleCount > 0) {
                    section.style.display = "";
                } else {
                    section.style.display = "none";
                }
            });
        });

        searchTrigger?.addEventListener("click", openCommandPalette);
        commandBackdrop?.addEventListener("click", closeCommandPalette);

        const openMobileMenu = () => {
            mobileOverlay?.classList.remove("hidden");
            document.body.classList.add("modal-open");
            requestAnimationFrame(() => mobileOverlay?.classList.add("open"));
        };

        const closeMobileMenu = () => {
            mobileOverlay?.classList.remove("open");
            document.body.classList.remove("modal-open");
            setTimeout(() => mobileOverlay?.classList.add("hidden"), 240);
        };

        mobileOpen?.addEventListener("click", openMobileMenu);
        mobileClose?.addEventListener("click", closeMobileMenu);
        mobileBackdrop?.addEventListener("click", closeMobileMenu);

        document.addEventListener("keydown", (event) => {
            if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
                event.preventDefault();
                if (commandPalette?.classList.contains("hidden")) openCommandPalette();
                else closeCommandPalette();
            }

            if (event.key === "Escape") {
                closeAllDropdowns();
                if (commandPalette && !commandPalette.classList.contains("hidden")) closeCommandPalette();
                if (mobileOverlay && !mobileOverlay.classList.contains("hidden")) closeMobileMenu();
            }
        });

        const currentPath = window.location.pathname;
        if (currentPath === "/dashboard") {
            document.querySelector('.litebill-nav-pill[href="/dashboard"]')?.classList.add("active");
        }
    });
</script>
