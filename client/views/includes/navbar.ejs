                    <% }) %>
                <% } %>
            </div>
        </div>

        <div class="dropdown-container">
            <a href="#" id="navBillingBtn" class="nav-item-center">Billing <i data-lucide="chevron-down" style="width: 14px; margin-left: 2px;"></i></a>
            <div id="navBillingDropdown" class="nav-dropdown-menu hidden">
                <% if (typeof navHouses !== 'undefined' && navHouses.length > 0) { %>
                    <a href="/houses/<%= navHouses[0]._id %>/main-bill/new" class="dropdown-item"><i data-lucide="pen-line"></i> Submit Readings</a>
                    <a href="/houses/<%= navHouses[0]._id %>/history" class="dropdown-item"><i data-lucide="history"></i> Billing History</a>
                    <a href="/houses/<%= navHouses[0]._id %>/cycles" class="dropdown-item"><i data-lucide="calendar-clock"></i> View Cycles</a>
                <% } else { %>
                    <a href="/houses/new" class="dropdown-item"><i data-lucide="home"></i> Add Property First</a>
                <% } %>
            </div>
        </div>

        <% if (typeof navHouses !== 'undefined' && navHouses.length > 0) { %>
            <a href="/houses/<%= navHouses[0]._id %>/history" class="nav-item-center">History</a>
        <% } %>
    </div>

    <div class="nav-actions-right">
        <button id="searchBtn" class="btn-icon btn-ghost"><i data-lucide="search"></i></button>
        
        <div class="dropdown-container desktop-only">
            <button id="quickAddBtn" class="btn btn-primary btn-quick-add">
                <i data-lucide="plus" style="width: 14px; height: 14px;"></i> Quick Add
            </button>
            <div id="quickAddDropdown" class="nav-dropdown-menu hidden" style="right: 0; transform-origin: top right;">
                <a href="/houses/new" class="dropdown-item"><i data-lucide="home"></i> New House</a>
                <% if (typeof navHouses !== 'undefined' && navHouses.length > 0) { %>
                    <a href="/houses/<%= navHouses[0]._id %>/rooms/new" class="dropdown-item"><i data-lucide="bed-double"></i> New Room</a>
                    <a href="/houses/<%= navHouses[0]._id %>/main-bill/new" class="dropdown-item"><i data-lucide="receipt"></i> Submit Bill</a>
                <% } %>
            </div>
        </div>

        <button class="btn-icon btn-ghost notification-btn desktop-only">
            <i data-lucide="bell"></i>
            <span class="notification-badge">2</span>
        </button>

        <div class="dropdown-container desktop-only">
            <a href="#" id="navUserBtn" class="user-avatar-gradient">
                <%= (typeof user !== 'undefined' && user.mobile_number) ? user.mobile_number[0] : 'U' %>
            </a>
            <div id="navUserDropdown" class="nav-dropdown-menu hidden" style="right: 0; transform-origin: top right;">
                <a href="/auth/profile" class="dropdown-item"><i data-lucide="user"></i> My Profile</a>
