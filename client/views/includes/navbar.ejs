<nav class="navbar top-navbar">
    <div class="brand">
        <a href="/dashboard" class="logo-link">
            <i data-lucide="zap" class="logo-icon"></i>
            <span class="logo-text">LiteBill</span>
        </a>
    </div>

    <div class="nav-links-center desktop-only" id="desktopNavLinks">
