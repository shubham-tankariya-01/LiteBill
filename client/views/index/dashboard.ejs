<% layout('layouts/boilerplate') %>

<% 
    const hour = new Date().getHours();
    let greetingTime = 'Good evening';
    if (hour < 12) greetingTime = 'Good morning';
    else if (hour < 18) greetingTime = 'Good afternoon';
    
    const userDisplay = (typeof user !== 'undefined' && user.mobile_number) ? '+91 ' + user.mobile_number : 'User';
    
    const dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
    const dateFormatted = new Date().toLocaleDateString('en-IN', dateOptions);
%>

<div class="page-header">
    <div>
        <h1 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.25rem;">
            <%= greetingTime %>, <%= userDisplay %>
        </h1>
        <p class="text-muted" style="font-size: 0.9rem;"><%= dateFormatted %></p>
    </div>
    <div style="display: flex; gap: 1rem;">
        <a href="/houses/new" class="btn btn-ghost"><i data-lucide="plus"></i> Add Property</a>
        <% if (typeof navHouses !== 'undefined' && navHouses.length > 0) { %>
            <a href="/houses/<%= navHouses[0]._id %>/main-bill/new" class="btn btn-primary"><i data-lucide="file-input"></i> Enter Main Bill</a>
        <% } %>
    </div>
</div>

<% if (typeof nextStep !== 'undefined' && nextStep !== 'complete') { 
    let bannerColor = 'var(--accent-orange)';
    let actionTitle = '';
    let instructionText = '';
    let actionLink = '';
    let actionBtnText = '';
    
    if (nextStep === 'add_house') {
        actionTitle = 'Add your first property';
        instructionText = 'Create a property to start managing your bills.';
        actionLink = '/houses/new';
        actionBtnText = 'Add Property';
        bannerColor = 'var(--accent-orange)';
    } else if (nextStep === 'setup') {
        actionTitle = 'Initial Setup Required';
        instructionText = 'Enter starting meter readings for a property.';
        actionLink = '/houses/' + actionHouseId + '/readings/new';
        actionBtnText = 'Setup Meters';
        bannerColor = 'var(--accent-orange)';
    } else if (nextStep === 'enter_bill') {
        actionTitle = 'Main Bill Required';
        instructionText = 'An active cycle is missing the supplier main bill.';
        actionLink = '/houses/' + actionHouseId + '/main-bill/new';
        actionBtnText = 'Enter Bill';
        bannerColor = 'var(--accent-orange)';
    } else if (nextStep === 'enter_readings') {
        actionTitle = 'Readings Pending';
        instructionText = 'Enter room meter readings to finalize the cycle.';
        actionLink = '/houses/' + actionHouseId + '/readings/new';
        actionBtnText = 'Enter Readings';
        bannerColor = 'var(--accent-blue)';
    }
%>
<div class="next-action-banner" style="border-left-color: <%= bannerColor %>;">
    <div style="display: flex; align-items: center; gap: 1rem;">
        <div class="pulsing-dot" style="background: <%= bannerColor %>; box-shadow: 0 0 0 0 <%= bannerColor %>80;"></div>
        <div>
            <h3 style="margin-bottom: 0.25rem; font-size: 1rem; color: var(--text-primary);"><%= actionTitle %></h3>
            <p style="margin: 0; font-size: 0.9rem; color: var(--text-secondary);"><%= instructionText %></p>
        </div>
    </div>
    <a href="<%= actionLink %>" class="btn btn-primary" style="background: <%= bannerColor %>; border-color: <%= bannerColor %>;"><%= actionBtnText %></a>
</div>
<% } %>

<div class="grid-3" style="margin-bottom: 2.5rem;">
    <!-- Card 1 -->
    <div class="card-raised card-accent" style="--card-accent-color: var(--accent-yellow);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
            <i data-lucide="home" style="color: var(--accent-yellow); width: 24px; height: 24px;"></i>
            <a href="/houses" class="btn btn-ghost btn-icon" style="padding: 0;"><i data-lucide="arrow-right"></i></a>
        </div>
        <div class="stat-number count-up" data-target="<%= typeof houseCount !== 'undefined' ? houseCount : 0 %>">0</div>
        <div class="stat-label">Active Properties</div>
    </div>

    <!-- Card 2 -->
    <div class="card-raised card-accent" style="--card-accent-color: var(--accent-blue);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
            <i data-lucide="refresh-cw" style="color: var(--accent-blue); width: 24px; height: 24px;"></i>
            <% if (typeof activeCyclesCount !== 'undefined' && activeCyclesCount > 0) { %>
                <span class="badge badge-blue">Processing</span>
            <% } %>
        </div>
        <div class="stat-number count-up" data-target="<%= typeof activeCyclesCount !== 'undefined' ? activeCyclesCount : 0 %>">0</div>
        <div class="stat-label">Active Cycles</div>
    </div>

    <!-- Card 3 -->
    <div class="card-raised card-accent" style="--card-accent-color: var(--accent-green);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
            <i data-lucide="indian-rupee" style="color: var(--accent-green); width: 24px; height: 24px;"></i>
        </div>
        <div class="stat-number" style="display: flex; align-items: baseline;">
            <span style="font-size: 1.5rem; margin-right: 0.25rem;">₹</span>
            <span class="count-up" data-target="<%= typeof totalRevenue !== 'undefined' ? totalRevenue : 0 %>">0</span>
        </div>
        <div class="stat-label">Across All Properties</div>
    </div>
</div>

<div class="dashboard-split">
    <!-- Left Column: Recent Activity -->
    <div class="dashboard-col-main">
        <div class="card-raised" style="height: 100%;">
            <h3 style="margin-bottom: 1.5rem; font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">Recent Activity</h3>
            
            <div class="activity-feed">
                <% if (typeof recentBills !== 'undefined' && recentBills.length > 0) { %>
                    <% recentBills.forEach(bill => { %>
                        <div class="activity-item">
                            <div class="activity-dot" style="background: var(--accent-green);"></div>
                            <div class="activity-content">
                                <div class="activity-text">
                                    <span style="color: var(--text-primary); font-weight: 600;">Bill finalized</span> for <%= bill.house_id ? bill.house_id.house_name : 'Property' %>
                                </div>
                                <div class="activity-time"><%= new Date(bill.bill_date).toLocaleDateString() %></div>
                            </div>
                            <div class="activity-amount">₹<%= bill.total_amount %></div>
                        </div>
                    <% }) %>
                    <div style="margin-top: 1.5rem; text-align: center;">
                        <a href="/houses" class="btn btn-ghost" style="font-size: 0.85rem;">View full history &rarr;</a>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <i data-lucide="activity" style="width: 48px; height: 48px; color: var(--border); margin-bottom: 1rem;"></i>
                        <p class="text-muted">No recent activity found.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Right Column: Quick Actions -->
    <div class="dashboard-col-side">
        <div class="card-raised" style="height: 100%;">
            <h3 style="margin-bottom: 1.5rem; font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">What would you like to do?</h3>
            
            <div class="quick-actions-grid">
                <a href="<%= (typeof navHouses !== 'undefined' && navHouses.length > 0) ? '/houses/' + navHouses[0]._id + '/main-bill/new' : '/houses/new' %>" class="quick-action-btn" style="--btn-color: var(--accent-green);">
                    <div class="qa-icon-wrap"><i data-lucide="zap"></i></div>
                    <div class="qa-label">Submit Readings</div>
                </a>
                
                <a href="/houses/new" class="quick-action-btn" style="--btn-color: var(--accent-yellow);">
                    <div class="qa-icon-wrap"><i data-lucide="home"></i></div>
                    <div class="qa-label">Add Property</div>
                </a>
                
                <a href="<%= (typeof navHouses !== 'undefined' && navHouses.length > 0) ? '/houses/' + navHouses[0]._id + '/history' : '/houses' %>" class="quick-action-btn" style="--btn-color: var(--accent-blue);">
                    <div class="qa-icon-wrap"><i data-lucide="history"></i></div>
                    <div class="qa-label">View History</div>
                </a>
                
                <a href="<%= (typeof navHouses !== 'undefined' && navHouses.length > 0) ? '/houses/' + navHouses[0]._id + '/rooms' : '/houses' %>" class="quick-action-btn" style="--btn-color: var(--accent-purple);">
                    <div class="qa-icon-wrap"><i data-lucide="bed-double"></i></div>
                    <div class="qa-label">Manage Rooms</div>
                </a>
            </div>
        </div>
    </div>
</div>

<% if (typeof navHouses !== 'undefined' && navHouses.length > 1) { %>
<div style="margin-top: 2.5rem;">
    <h3 style="margin-bottom: 1.5rem; font-size: 1.1rem;">Your Properties</h3>
    <div class="houses-strip">
        <% navHouses.forEach(house => { %>
            <div class="house-mini-card">
                <div style="font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;"><%= house.house_name %></div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <span class="badge badge-dim"><i data-lucide="bed" style="width: 12px; margin-right: 4px;"></i> Rooms</span>
                    <span class="badge badge-blue">Active</span>
                </div>
                <a href="/houses/<%= house._id %>" class="btn btn-outline" style="width: 100%; padding: 0.5rem; font-size: 0.8rem;">Enter Dashboard</a>
            </div>
        <% }) %>
    </div>
</div>
<% } %>

<style>
    /* Next Action Banner */
    .next-action-banner {
        background: var(--surface-raised);
        border-radius: var(--radius-card);
        border-left: 4px solid var(--accent-orange);
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        box-shadow: 0 4px 24px rgba(0,0,0,0.4);
    }
    
    .pulsing-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        animation: pulse 2s infinite;
        flex-shrink: 0;
    }

    /* Dashboard Layout */
    .dashboard-split {
        display: flex;
        gap: 1.5rem;
    }
    
    .dashboard-col-main {
        flex: 6; /* 60% approx */
    }
    
    .dashboard-col-side {
        flex: 4; /* 40% approx */
    }

    /* Activity Feed */
    .activity-feed {
        display: flex;
        flex-direction: column;
    }
    
    .activity-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding-bottom: 1.5rem;
        position: relative;
    }
    
    .activity-item:not(:last-child)::before {
        content: '';
        position: absolute;
        left: 5px;
        top: 20px;
        bottom: 0;
        width: 2px;
        background: var(--border);
    }
    
    .activity-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin-top: 5px;
        position: relative;
        z-index: 1;
        box-shadow: 0 0 0 4px var(--surface-raised);
    }
    
    .activity-content {
        flex: 1;
    }
    
    .activity-text {
        font-size: 0.95rem;
        color: var(--text-secondary);
        margin-bottom: 0.25rem;
    }
    
    .activity-time {
        font-size: 0.8rem;
        color: var(--text-dim);
    }
    
    .activity-amount {
        font-weight: 700;
        color: var(--text-primary);
        font-size: 1.05rem;
    }

    /* Quick Actions Grid */
    .quick-actions-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
    
    .quick-action-btn {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
    }
    
    .quick-action-btn:hover {
        transform: translateY(-2px);
        border-color: var(--btn-color);
        background: linear-gradient(180deg, rgba(255,255,255,0.02) 0%, rgba(0,0,0,0) 100%);
    }
    
    .qa-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(255,255,255,0.03);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.75rem;
        color: var(--btn-color);
        transition: all 0.2s ease;
    }
    
    .quick-action-btn:hover .qa-icon-wrap {
        background: var(--btn-color);
        color: #fff;
    }
    
    .qa-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    /* Houses Strip */
    .houses-strip {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        padding-bottom: 1rem;
        scrollbar-width: none; /* Firefox */
    }
    .houses-strip::-webkit-scrollbar {
        display: none; /* Chrome */
    }
    
    .house-mini-card {
        min-width: 240px;
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.25rem;
        flex-shrink: 0;
    }

    .empty-state {
        text-align: center;
        padding: 2rem 0;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    @media (max-width: 900px) {
        .dashboard-split { flex-direction: column; }
        .next-action-banner { flex-direction: column; align-items: flex-start; gap: 1rem; }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Count Up Animation
        const counters = document.querySelectorAll('.count-up');
        const speed = 200;

        counters.forEach(counter => {
            const updateCount = () => {
                const target = +counter.getAttribute('data-target');
                const count = +counter.innerText.replace(/,/g, '');
                
                const inc = target / speed;

                if (count < target) {
                    counter.innerText = Math.ceil(count + inc).toLocaleString();
                    setTimeout(updateCount, 10);
                } else {
                    counter.innerText = target.toLocaleString();
                }
            };
            
            const observer = new IntersectionObserver((entries) => {
                if (entries[0].isIntersecting) {
                    updateCount();
                    observer.disconnect();
                }
            }, { threshold: 0.5 });
            
            observer.observe(counter);
        });
    });
</script>