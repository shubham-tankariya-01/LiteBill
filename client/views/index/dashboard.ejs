<% layout('layouts/boilerplate') %>

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
        <h1 style="display: flex; align-items: center; gap: 0.5rem;">
            <i data-lucide="layout-dashboard" style="color: var(--accent-orange);"></i> System Overview
        </h1>
        <p class="text-muted" style="margin-top: 0.5rem;">Welcome back! Here's a summary of your properties and billing.</p>
    </div>
    <div style="display: flex; gap: 1rem;">
        <a href="/houses/new" class="btn btn-outline"><i data-lucide="home"></i> Add Property</a>
        <% if (typeof navHouses !== 'undefined' && navHouses.length === 1) { %>
            <a href="/houses/<%= navHouses[0]._id %>/main-bill/new" class="btn btn-primary" style="background: var(--accent-blue); border-color: var(--accent-blue);">
                <i data-lucide="file-input"></i> Enter Main Bill
            </a>
        <% } else if (typeof navHouses !== 'undefined' && navHouses.length > 1) { %>
            <div class="dropdown-container" style="position: relative;">
                <button id="dashEnterBillBtn" class="btn btn-primary" style="background: var(--accent-blue); border-color: var(--accent-blue); cursor: pointer;">
                    <i data-lucide="file-input"></i> Enter Main Bill <i data-lucide="chevron-down" style="width: 14px; margin-left: 4px;"></i>
                </button>
                <div id="dashEnterBillDropdown" class="nav-dropdown-menu hidden" style="left: 0; transform-origin: top left; min-width: 200px;">
                    <div class="dropdown-header">Select Property</div>
                    <% navHouses.forEach(house => { %>
                        <a href="/houses/<%= house._id %>/main-bill/new" class="dropdown-item">
                            <i data-lucide="home" style="width: 14px; color: var(--accent-yellow);"></i> <%= house.house_name %>
                        </a>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>
</div>

<div class="grid-layout">
    <!-- Houses Widget -->
    <div class="analytic-card theme-house">
        <div style="display: flex; justify-content: space-between; align-items: start;">
            <h3><i data-lucide="home" style="color: var(--accent-yellow);"></i> Properties</h3>
            <div style="padding: 0.5rem; background: rgba(251, 203, 69, 0.1); border-radius: 50%;">
                <i data-lucide="building" style="color: var(--accent-yellow); width: 24px; height: 24px;"></i>
            </div>
        </div>
        <p class="text-muted" style="margin-bottom: 1.5rem; font-size: 0.85rem;">Manage your active rental units and houses.</p>
        <div style="font-size: 2.5rem; font-weight: 700; color: var(--text-main); margin-bottom: 1.5rem; line-height: 1;">
            <%= typeof houseCount !== 'undefined' ? houseCount : 0 %> 
            <span style="font-size: 1rem; color: var(--text-muted); font-weight: 500;">Active</span>
        </div>
        <a href="/houses" class="btn btn-outline" style="width: 100%;">Manage Properties</a>
    </div>

    <!-- Billing Cycles Widget -->
    <div class="analytic-card theme-cycle">
        <div style="display: flex; justify-content: space-between; align-items: start;">
            <h3><i data-lucide="calendar-clock" style="color: var(--accent-blue);"></i> Ongoing Cycles</h3>
            <div style="padding: 0.5rem; background: rgba(112, 178, 220, 0.1); border-radius: 50%;">
                <i data-lucide="refresh-cw" style="color: var(--accent-blue); width: 24px; height: 24px;"></i>
            </div>
        </div>
        <p class="text-muted" style="margin-bottom: 1.5rem; font-size: 0.85rem;">Currently active calculation periods across all properties.</p>
        <div style="font-size: 2.5rem; font-weight: 700; color: var(--text-main); margin-bottom: 1.5rem; line-height: 1;">
            <%= typeof activeCyclesCount !== 'undefined' ? activeCyclesCount : 0 %> 
            <% if (typeof activeCyclesCount !== 'undefined' && activeCyclesCount > 0) { %>
                <span class="badge" style="background: rgba(112, 178, 220, 0.2); color: var(--accent-blue); font-size: 0.8rem; margin-left: 0.5rem;">Processing</span>
            <% } %>
        </div>
        <a href="/cycles" class="btn btn-outline" style="width: 100%; border-color: var(--accent-blue); color: var(--accent-blue);">Monitor Cycles</a>
    </div>

    <!-- Revenue / Bills Widget -->
    <div class="analytic-card theme-bill" style="border-top-color: #10B981;">
        <div style="display: flex; justify-content: space-between; align-items: start;">
            <h3 style="color: #10B981;"><i data-lucide="indian-rupee" style="color: #10B981;"></i> Total Billed</h3>
            <div style="padding: 0.5rem; background: rgba(16, 185, 129, 0.1); border-radius: 50%;">
                <i data-lucide="trending-up" style="color: #10B981; width: 24px; height: 24px;"></i>
            </div>
        </div>
        <p class="text-muted" style="margin-bottom: 1.5rem; font-size: 0.85rem;">Cumulative calculated balances from all main bills.</p>
        <div style="font-size: 2.5rem; font-weight: 700; color: var(--text-main); margin-bottom: 1.5rem; line-height: 1;">
            ₹<%= typeof totalRevenue !== 'undefined' ? totalRevenue.toLocaleString() : '0' %>
        </div>
        <% if (typeof navHouses !== 'undefined' && navHouses.length > 0) { %>
            <a href="/houses/<%= navHouses[0]._id %>/history" class="btn btn-green" style="width: 100%;">View History</a>
        <% } else { %>
            <a href="/cycles" class="btn btn-green" style="width: 100%;">Collection Hub</a>
        <% } %>
    </div>
</div>

<!-- Quick Actions & Insights Section -->
<div class="grid-layout" style="margin-top: 2rem;">
    <div class="analytic-card" style="border-top: 4px solid var(--accent-orange);">
        <h3><i data-lucide="zap" style="color: var(--accent-orange);"></i> Quick Shortcuts</h3>
        <p class="text-muted" style="margin-bottom: 1.5rem; font-size: 0.85rem;">Fast track to common tasks.</p>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
            <a href="/houses/new" class="btn btn-outline" style="justify-content: flex-start; padding: 1rem; border-color: var(--border-soft);">
                <i data-lucide="plus-circle" style="color: var(--accent-yellow); margin-right: 0.5rem;"></i> Create Property
            </a>
            
            <% if (typeof navHouses !== 'undefined' && navHouses.length === 1) { %>
                <a href="/houses/<%= navHouses[0]._id %>/main-bill/new" class="btn btn-outline" style="justify-content: flex-start; padding: 1rem; border-color: var(--border-soft);">
                    <i data-lucide="file-input" style="color: #10B981; margin-right: 0.5rem;"></i> Enter Main Bill
                </a>
                <a href="/houses/<%= navHouses[0]._id %>/rooms" class="btn btn-outline" style="justify-content: flex-start; padding: 1rem; border-color: var(--border-soft);">
                    <i data-lucide="bed-double" style="color: var(--accent-pink); margin-right: 0.5rem;"></i> Manage Rooms
                </a>
            <% } else if (typeof navHouses !== 'undefined' && navHouses.length > 1) { %>
                <div class="dropdown-container" style="position: relative;">
                    <button id="quickEnterBillBtn" class="btn btn-outline" style="width: 100%; justify-content: flex-start; padding: 1rem; border-color: var(--border-soft); cursor: pointer; background: white;">
                        <i data-lucide="file-input" style="color: #10B981; margin-right: 0.5rem;"></i> Enter Main Bill <i data-lucide="chevron-down" style="width: 14px; margin-left: auto;"></i>
                    </button>
                    <div id="quickEnterBillDropdown" class="nav-dropdown-menu hidden" style="top: 100%; left: 0; min-width: 200px; transform-origin: top;">
                        <div class="dropdown-header">Select Property</div>
                        <% navHouses.forEach(house => { %>
                            <a href="/houses/<%= house._id %>/main-bill/new" class="dropdown-item">
                                <i data-lucide="home" style="width: 14px; color: var(--accent-yellow);"></i> <%= house.house_name %>
                            </a>
                        <% }) %>
                    </div>
                </div>

                <div class="dropdown-container" style="position: relative;">
                    <button id="quickManageRoomsBtn" class="btn btn-outline" style="width: 100%; justify-content: flex-start; padding: 1rem; border-color: var(--border-soft); cursor: pointer; background: white;">
                        <i data-lucide="bed-double" style="color: var(--accent-pink); margin-right: 0.5rem;"></i> Manage Rooms <i data-lucide="chevron-down" style="width: 14px; margin-left: auto;"></i>
                    </button>
                    <div id="quickManageRoomsDropdown" class="nav-dropdown-menu hidden" style="top: 100%; left: 0; min-width: 200px; transform-origin: top;">
                        <div class="dropdown-header">Select Property</div>
                        <% navHouses.forEach(house => { %>
                            <a href="/houses/<%= house._id %>/rooms" class="dropdown-item">
                                <i data-lucide="home" style="width: 14px; color: var(--accent-yellow);"></i> <%= house.house_name %>
                            </a>
                        <% }) %>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const setupLocalDropdown = (btnId, menuId) => {
            const btn = document.getElementById(btnId);
            const menu = document.getElementById(menuId);
            if (btn && menu) {
                btn.addEventListener("click", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    document.querySelectorAll('.nav-dropdown-menu').forEach(m => {
                        if (m !== menu) {
                            m.classList.add('hidden');
                            m.style.top = ''; m.style.bottom = ''; m.style.marginTop = ''; m.style.marginBottom = '';
                        }
                    });
                    
                    if (menu.classList.contains("hidden")) {
                        menu.classList.remove("hidden");
                        const rect = btn.getBoundingClientRect();
                        if ((window.innerHeight - rect.bottom) < 260) {
                            menu.style.top = 'auto'; menu.style.bottom = '100%';
                            menu.style.marginTop = '0'; menu.style.marginBottom = '0.75rem';
                            menu.style.transformOrigin = 'bottom left';
                        } else {
                            menu.style.top = '100%'; menu.style.bottom = 'auto';
                            menu.style.marginTop = '0.75rem'; menu.style.marginBottom = '0';
                            menu.style.transformOrigin = 'top left';
                        }
                    } else {
                        menu.classList.add("hidden");
                    }
                });
            }
        };

        setupLocalDropdown("dashEnterBillBtn", "dashEnterBillDropdown");
        setupLocalDropdown("quickEnterBillBtn", "quickEnterBillDropdown");
        setupLocalDropdown("quickManageRoomsBtn", "quickManageRoomsDropdown");
    });
</script>