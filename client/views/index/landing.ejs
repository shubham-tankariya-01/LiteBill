<% layout('layouts/boilerplate') %>

<div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
    <div style="text-align: center; max-width: 500px;">
        <i data-lucide="zap" style="width: 48px; height: 48px; color: var(--accent-orange); margin-bottom: 1.5rem;"></i>
        <h1 style="font-size: 3rem; font-weight: 700; letter-spacing: -1px; margin-bottom: 1rem;">LiteBill<span style="color: var(--accent-orange);">.</span></h1>
        <p style="color: var(--text-muted); margin-bottom: 2.5rem; font-size: 1.1rem;">Modern utility bill tracking inspired by aviation dashboards. Pure precision.</p>
        
        <div style="display: flex; gap: 1rem; justify-content: center;">
            <a href="/auth/login" class="btn btn-outline" style="min-width: 120px;">Log In</a>
            <a href="/auth/signup" class="btn btn-primary" style="min-width: 120px;">Get Started</a>
        </div>
    </div>
</div>
