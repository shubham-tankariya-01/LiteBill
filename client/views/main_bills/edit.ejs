<% layout('layouts/boilerplate') %>

<div class="container" style="max-width: 600px; margin: 0 auto; padding: 2rem;">
    <div class="analytic-card theme-bill" style="border-top-color: var(--accent-yellow);">
        <h2 style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="file-text" style="color: var(--accent-yellow);"></i> Edit Main Bill</h2>
        <p class="text-muted" style="margin-bottom: 2rem;">Update the supplier main bill details.</p>

        <form action="/main-bill/<%= mainBill._id %>?_method=PUT" method="POST">
            <div class="form-group">
                <label class="form-label" for="total_units">Total Units Generated/Used :</label>
                <input type="number" step="0.01" id="total_units" name="total_units" class="form-control" value="<%= mainBill.total_units %>" required placeholder="0.00">
            </div>

            <div class="form-group">
                <label class="form-label" for="total_amount">Total Bill Amount (₹) :</label>
                <input type="number" step="0.01" id="total_amount" name="total_amount" class="form-control" value="<%= mainBill.total_amount %>" required placeholder="0.00">
            </div>
            
            <div class="form-group">
                <label class="form-label" for="bill_date">Bill Date :</label>
                <% 
                   // format the date for input[type=date]
                   let formattedDate = '';
                   if (mainBill.bill_date) {
                       const d = new Date(mainBill.bill_date);
                       if (!isNaN(d)) {
                           formattedDate = d.toISOString().split('T')[0];
                       }
                   }
                %>
                <input type="date" id="bill_date" name="bill_date" class="form-control" value="<%= formattedDate %>" required>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">Save Changes</button>
                <a href="/houses/<%= mainBill.house_id %>/history" class="btn btn-outline" style="flex: 1;">Cancel</a>
            </div>
        </form>
    </div>
</div>
