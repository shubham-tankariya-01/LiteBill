<% layout('layouts/boilerplate') %>

<%
    let startDateStr = '';
    if (mainBill.bill_date) {
        const derivedStartDate = new Date(mainBill.bill_date);
        derivedStartDate.setDate(derivedStartDate.getDate() - 30);
        startDateStr = derivedStartDate.toISOString().split('T')[0];
    }
%>

<div class="bill-breadcrumb">Properties / House / Edit Main Bill</div>

<section class="bill-header">
    <h1 class="bill-title">
        <i data-lucide="file-edit"></i>
        <span>Edit Supplier Bill</span>
    </h1>
</section>

<section class="bill-warning-card">
    <i data-lucide="alert-triangle"></i>
    <div>
        <div class="bill-warning-title">Editing will recalculate all room bills for this cycle.</div>
        <div class="bill-warning-copy">Update carefully. This change affects the cycle-wide split and every generated room bill linked to it.</div>
    </div>
</section>

<section class="bill-layout">
    <article class="card bill-form-card">
        <div class="section-title" style="margin-bottom: 24px;">Supplier Bill Details</div>

        <form action="/main-bill/<%= mainBill._id %>?_method=PUT" method="POST" id="mainBillEditForm">
            <div class="form-group">
                <label class="form-label" for="total_units">Total Units</label>
                <div class="bill-input-combo bill-input-combo-right">
                    <input type="number" step="0.01" min="0" id="total_units" name="total_units" class="form-input" value="<%= mainBill.total_units %>" required placeholder="0.00">
                    <span class="bill-input-chip">kWh</span>
                </div>
                <p class="bill-help">Enter the total energy usage shown on the supplier bill.</p>
            </div>

            <div class="form-group">
                <label class="form-label" for="total_amount">Total Amount</label>
                <div class="bill-input-combo bill-input-combo-left">
                    <span class="bill-input-chip">₹</span>
                    <input type="number" step="0.01" min="0" id="total_amount" name="total_amount" class="form-input" value="<%= mainBill.total_amount %>" required placeholder="0.00">
                </div>
                <p class="bill-help">Use the exact final bill amount that should be distributed.</p>
            </div>

            <div class="bill-date-row">
                <div class="form-group">
                    <label class="form-label" for="start_date">Cycle Start</label>
                    <input type="date" id="start_date" name="start_date" class="form-input bill-readonly-input" value="<%= startDateStr %>" readonly>
                </div>

                <div class="form-group">
                    <label class="form-label" for="bill_date">Bill Date</label>
                    <input type="date" id="bill_date" name="bill_date" class="form-input bill-date-input" value="<%= mainBill.bill_date ? new Date(mainBill.bill_date).toISOString().split('T')[0] : '' %>" required>
                </div>
            </div>

            <div class="bill-actions-row">
                <a href="/houses/<%= houseId %>/history" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary bill-submit-btn">Save Main Bill -&gt;</button>
            </div>
        </form>
    </article>

    <aside class="bill-preview-card">
        <div class="bill-preview-head">
            <div class="bill-preview-title">
                <i data-lucide="bar-chart-2"></i>
                <span>Calculation Preview</span>
            </div>
            <span class="badge badge-dim" id="cycleDaysCounter">0 Days Covered</span>
        </div>

        <div class="bill-cost-box">
            <div class="bill-cost-label">Cost Per Unit</div>
            <div class="bill-cost-value" id="costPerUnitDisplay">₹0.00</div>
        </div>

        <div class="bill-preview-section-title">Estimated Split (<span id="roomCountLabel"><%= roomCount %></span> Rooms)</div>

        <% if (typeof rooms !== 'undefined' && rooms.length > 0) { %>
            <div class="bill-room-list">
                <% rooms.forEach((room) => { %>
                    <div class="bill-room-row">
                        <div class="bill-room-name">
                            <i data-lucide="bed-double"></i>
                            <span><%= room.meter_name %></span>
                        </div>
                        <div class="bill-room-share">₹—</div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p class="bill-preview-empty">No rooms configured.</p>
        <% } %>
    </aside>
</section>

<style>
    .bill-breadcrumb {
        margin-bottom: 14px;
        color: #7A7A8A;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .bill-header {
        margin-bottom: 20px;
    }

    .bill-title {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 1.75rem;
        font-weight: 800;
        line-height: 1.1;
    }

    .bill-title i {
        width: 24px;
        height: 24px;
        color: #FF6B2B;
    }

    .bill-warning-card {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px 20px;
        margin-bottom: 20px;
        border-left: 4px solid #FF8C00;
        border-radius: 12px;
        background: #FFF8E6;
    }

    .bill-warning-card i {
        width: 20px;
        height: 20px;
        color: #FF8C00;
        margin-top: 2px;
        flex-shrink: 0;
    }

    .bill-warning-title {
        color: #8A4B00;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .bill-warning-copy {
        color: #9C6700;
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .bill-layout {
        display: flex;
        gap: 24px;
        align-items: flex-start;
    }

    .bill-form-card {
        flex: 1.5;
        min-width: 350px;
        padding: 32px;
    }

    .bill-input-combo {
        display: flex;
        align-items: stretch;
    }

    .bill-input-combo .form-input {
        flex: 1;
    }

    .bill-input-combo-left .form-input {
        border-radius: 0 12px 12px 0;
    }

    .bill-input-combo-right .form-input {
        border-radius: 12px 0 0 12px;
    }

    .bill-input-chip {
        min-height: 48px;
        padding: 14px 12px;
        background: #F0EFE9;
        color: #7A7A8A;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        border: 1.5px solid #E8E7E2;
    }

    .bill-input-combo-left .bill-input-chip {
        border-radius: 12px 0 0 12px;
        border-right: 0;
        color: #1A1A1A;
    }

    .bill-input-combo-right .bill-input-chip {
        border-radius: 0 12px 12px 0;
        border-left: 0;
    }

    .bill-help {
        margin-top: 8px;
        color: #7A7A8A;
        font-size: 0.8rem;
    }

    .bill-date-row {
        display: flex;
        gap: 16px;
    }

    .bill-date-row .form-group {
        flex: 1;
    }

    .bill-readonly-input {
        opacity: 0.5;
        pointer-events: none;
    }

    .bill-date-input::-webkit-calendar-picker-indicator {
        filter: brightness(0) saturate(100%);
        opacity: 0.75;
        cursor: pointer;
    }

    .bill-actions-row {
        display: flex;
        gap: 12px;
        margin-top: 8px;
    }

    .bill-actions-row .btn:first-child {
        flex: 1;
    }

    .bill-submit-btn {
        flex: 1.5;
    }

    .bill-preview-card {
        position: sticky;
        top: 88px;
        flex: 1;
        min-width: 280px;
        padding: 24px;
        border-radius: 20px;
        background: #1F1F1F;
    }

    .bill-preview-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 20px;
    }

    .bill-preview-title {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #FFFFFF;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .bill-preview-title i {
        width: 20px;
        height: 20px;
        color: #FF6B2B;
    }

    .bill-preview-card .badge {
        color: #A0A0B0;
        background: rgba(255, 255, 255, 0.08);
    }

    .bill-cost-box {
        padding: 20px;
        margin-bottom: 20px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.05);
        text-align: center;
    }

    .bill-cost-label {
        margin-bottom: 10px;
        color: #A0A0B0;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .bill-cost-value {
        color: #FFFFFF;
        font-size: 3rem;
        font-weight: 800;
        line-height: 1;
    }

    .bill-preview-section-title {
        padding-bottom: 10px;
        margin-bottom: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        color: #A0A0B0;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .bill-room-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .bill-room-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .bill-room-name {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #FFFFFF;
        font-size: 0.9rem;
    }

    .bill-room-name i {
        width: 14px;
        height: 14px;
        color: #A0A0B0;
    }

    .bill-room-share {
        color: #A0A0B0;
        font-weight: 700;
    }

    .bill-preview-empty {
        color: #A0A0B0;
        font-size: 0.85rem;
    }

    @media (max-width: 768px) {
        .bill-layout {
            flex-direction: column;
        }

        .bill-form-card,
        .bill-preview-card {
            width: 100%;
            min-width: 0;
        }

        .bill-preview-card {
            position: static;
        }

        .bill-date-row,
        .bill-actions-row {
            flex-direction: row;
        }

        .bill-actions-row .btn {
            flex: 1;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const totalUnitsInput = document.getElementById('total_units');
        const totalAmountInput = document.getElementById('total_amount');
        const startDateInput = document.getElementById('start_date');
        const billDateInput = document.getElementById('bill_date');
        const costPerUnitDisplay = document.getElementById('costPerUnitDisplay');
        const roomShareElements = document.querySelectorAll('.bill-room-share');
        const daysCounter = document.getElementById('cycleDaysCounter');
        const roomCount = <%= typeof roomCount !== 'undefined' ? roomCount : 0 %>;

        const updatePreview = () => {
            const units = parseFloat(totalUnitsInput.value);
            const amount = parseFloat(totalAmountInput.value);

            if (!Number.isNaN(units) && !Number.isNaN(amount) && units > 0) {
                const costPerUnit = amount / units;
                costPerUnitDisplay.textContent = `₹${costPerUnit.toFixed(2)}`;

                const perRoomEstimate = roomCount > 0 ? amount / roomCount : 0;
                roomShareElements.forEach((element) => {
                    element.textContent = roomCount > 0 ? `₹${perRoomEstimate.toFixed(0)}` : '₹—';
                    element.style.color = roomCount > 0 ? '#FFFFFF' : '#A0A0B0';
                });
            } else {
                costPerUnitDisplay.textContent = '₹0.00';
                roomShareElements.forEach((element) => {
                    element.textContent = '₹—';
                    element.style.color = '#A0A0B0';
                });
            }
        };

        const updateDays = () => {
            if (!startDateInput.value || !billDateInput.value) {
                daysCounter.textContent = '0 Days Covered';
                return;
            }

            const startDate = new Date(startDateInput.value);
            const billDate = new Date(billDateInput.value);
            const diffTime = Math.abs(billDate - startDate);
            const diffDays = Math.max(Math.ceil(diffTime / (1000 * 60 * 60 * 24)), 0);
            daysCounter.textContent = `${diffDays} Days Covered`;
        };

        totalUnitsInput?.addEventListener('input', updatePreview);
        totalAmountInput?.addEventListener('input', updatePreview);
        billDateInput?.addEventListener('change', updateDays);

        updatePreview();
        updateDays();
    });
</script>
