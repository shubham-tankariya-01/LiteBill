<% layout('layouts/boilerplate') %>

    <div class="container" style="max-width: 600px;">
        <div class="analytic-card border-top-yellow">
            <h2 style="color: var(--accent-yellow-light);">Supplier Main Bill</h2>

            <form action="/houses/<%= houseId %>/main-bill" method="POST">
                <div class="form-group">
                    <label class="form-label" for="total_units">Total Units Generated/Used : </label>
                    <input type="number" step="0.01" id="total_units" name="total_units" class="form-control" required
                        placeholder="0.00">
                </div>

                <div class="form-group">
                    <label class="form-label" for="total_amount">Total Bill Amount (₹) :</label>
                    <input type="number" step="0.01" id="total_amount" name="total_amount" class="form-control" required
                        placeholder="0.00">
                </div>
                <label for="duration" style="color: var(--text-muted); font-weight: 700;">Billing Duration: </label>
                <div class="form-group" id='duration'
                    style="display: flex; flex-wrap: wrap; gap: 1rem; padding-top: 0.5rem;">
                    <div style="flex: 1;">
                        <label class="form-label" for="start_date">Start Date</label>
                        <input type="date" id="start_date" name="start_date" class="form-control" required>
                    </div>
                    <div style="flex: 1;">

                        <label class="form-label" for="end_date">End Date</label>
                        <input type="date" id="end_date" name="end_date" class="form-control" required>
                    </div>
                </div>

                <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                    <button type="submit" class="btn btn-primary" style="flex: 1;">Save Main Bill</button>
                    <a href="#" class="btn btn-outline" style="flex: 1;">Cancel</a>
                </div>
            </form>
        </div>
    </div>
    <style>
        .container {
            margin: 0 auto;
            padding: 2rem;
        }

        form label {
            color: var(--text-muted);
        }
    </style>