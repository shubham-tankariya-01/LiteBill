<% layout('layouts/boilerplate') %>

    <div class="analytic-card">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 2rem;">
            <div>
                <h2>Record Room Readings</h2>
                <p class="text-muted">Enter the current meter readings for all rooms. This will create a new Billing
                    Cycle.</p>
            </div>
            <i data-lucide="zap" style="color: var(--primary); width: 32px; height: 32px;"></i>
        </div>

        <form action="/houses/<%= houseId %>/cycles/<%= cycleId %>/readings" method="POST">

            <% rooms.forEach(room=> { %>
                <div class="analytic-card reading-input"
                    style="margin-bottom: 1.5rem; background: var(--bg-main); border: none;">
                    <h4 style="margin-bottom: 1rem;">
                        <%= room.meter_name %>
                    </h4>
                    <div class="grid-layout">
                        <div class="form-group">
                            <label class="form-label" for="reading_1">Current Reading</label>
                            <input type="number" step="0.1" id="reading_1" name="readings[<%= room._id %>][units]"
                                class="form-control" required placeholder="0.0">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="date_1">Reading Date</label>
                            <input type="date" id="date_1" value="<%= new Date().toISOString().split('T')[0] %>"
                                name="readings[<%= room._id %>][date]" class="form-control" required>
                        </div>
                    </div>
                </div>
                <% }) %>

                    <div style="display: flex; gap: 1rem; margin-top: 2rem; max-width: 400px;">
                        <button type="submit" class="btn btn-primary" style="flex: 1;">Submit & Start Cycle</button>
                        <a href="/houses/<%= houseId %>" class="btn btn-outline" style="flex: 1;">Cancel</a>
                    </div>
        </form>
    </div>