<% layout('layouts/boilerplate') %>

<%
    const avgRate = mainBill.total_units > 0 ? (mainBill.total_amount / mainBill.total_units).toFixed(2) : '0.00';
%>

<section class="readings-header">
    <h1 class="readings-title">
        <i data-lucide="zap"></i>
        <span>Record Meter Readings</span>
    </h1>
    <p class="readings-subtitle">Enter the latest readings for every room to close this cycle and generate bills.</p>
</section>

<section class="readings-context-bar">
    <div class="readings-context-copy">
        <div class="readings-context-label">Supplier Bill Target</div>
        <div class="readings-context-text">Match these totals across your rooms.</div>
    </div>

    <div class="readings-context-chips">
        <div class="readings-context-chip">
            <div class="readings-context-chip-label">Total Units</div>
            <div class="readings-context-chip-value"><%= Number(mainBill.total_units || 0).toLocaleString('en-IN') %> U</div>
        </div>
        <div class="readings-context-chip">
            <div class="readings-context-chip-label">Total Amount</div>
            <div class="readings-context-chip-value">&#8377;<%= Number(mainBill.total_amount || 0).toLocaleString('en-IN') %></div>
        </div>
        <div class="readings-context-chip">
            <div class="readings-context-chip-label">Avg Rate</div>
            <div class="readings-context-chip-value">&#8377;<%= avgRate %>/U</div>
        </div>
    </div>
</section>

<form id="readingsForm" action="/houses/<%= houseId %>/cycles/<%= cycleId %>/readings" method="POST" class="readings-form">
    <% rooms.forEach((room) => { %>
        <article class="readings-room-card">
            <div class="readings-card-top">
                <div class="readings-card-title-wrap">
                    <i data-lucide="gauge"></i>
                    <h3><%= room.meter_name %></h3>
                </div>

                <div class="readings-date-wrap">
                    <label class="form-label" for="date_<%= room._id %>">Reading Date</label>
                    <input
                        type="date"
                        id="date_<%= room._id %>"
                        value="<%= new Date().toISOString().split('T')[0] %>"
                        name="readings[<%= room._id %>][date]"
                        class="form-input readings-date-input"
                        required
                    >
                </div>
            </div>

            <div class="readings-card-body">
                <div class="readings-stat-block">
                    <div class="readings-stat-label">Previous</div>
                    <div class="readings-prev-box"><%= previousReadings[room._id.toString()] ?? '0' %> U</div>
                </div>

                <div class="readings-arrow-wrap">
                    <i data-lucide="arrow-right"></i>
                </div>

                <div class="readings-input-block">
                    <div class="readings-stat-label">Current</div>
                    <div class="readings-current-wrap">
                        <input
                            type="number"
                            min="0"
                            step="0.1"
                            id="reading_<%= room._id %>"
                            name="readings[<%= room._id %>][units]"
                            class="form-input current-reading-input"
                            data-prev="<%= previousReadings[room._id.toString()] || 0 %>"
                            placeholder="0.0"
                            required
                        >
                        <span class="readings-unit-suffix">U</span>
                    </div>
                    <div class="inline-error">Current reading must be greater than or equal to previous.</div>
                </div>

                <div class="readings-result-block">
                    <div class="readings-stat-label">Units This Cycle</div>
                    <div class="diff-display">—</div>
                </div>
            </div>
        </article>
    <% }) %>

    <div class="readings-sticky-shell">
        <div class="readings-sticky-bar">
            <div class="readings-sticky-summary">
                <div class="readings-total-distributed"><span id="totalDistributed">0.0</span> U distributed</div>
                <div id="matchIndicator" class="readings-match-pill is-waiting">Awaiting Input</div>
            </div>

            <div class="readings-sticky-actions">
                <a href="/houses/<%= houseId %>" class="btn btn-secondary">Cancel</a>
                <button type="submit" id="submitBtn" class="btn btn-primary readings-submit-btn" disabled>Submit Readings -&gt;</button>
            </div>
        </div>
    </div>
</form>

<style>
    .readings-header {
        margin-bottom: 24px;
    }

    .readings-title {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
        font-size: 1.75rem;
        font-weight: 800;
        line-height: 1.1;
    }

    .readings-title i {
        width: 24px;
        height: 24px;
        color: #4CAF7D;
    }

    .readings-subtitle {
        color: #7A7A8A;
        font-size: 0.95rem;
    }

    .readings-context-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 24px;
        padding: 20px 28px;
        border-radius: 20px;
        background: #1F1F1F;
    }

    .readings-context-label {
        color: #A0A0B0;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 6px;
    }

    .readings-context-text {
        color: #FFFFFF;
        font-weight: 600;
        font-size: 1rem;
    }

    .readings-context-chips {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .readings-context-chip {
        padding: 12px 16px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.07);
    }

    .readings-context-chip-label {
        color: #A0A0B0;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 4px;
    }

    .readings-context-chip-value {
        color: #FFFFFF;
        font-weight: 700;
    }

    .readings-form {
        padding-bottom: 120px;
    }

    .readings-room-card {
        margin-bottom: 16px;
        padding: 24px;
        border-radius: 20px;
        border-left: 4px solid #E8E7E2;
        background: #FFFFFF;
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.07);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .readings-room-card.is-valid {
        border-left-color: #4CAF7D;
    }

    .readings-room-card.is-error {
        border-left-color: #FF6B2B;
    }

    .readings-room-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
    }

    .readings-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

    .readings-card-title-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .readings-card-title-wrap i {
        width: 18px;
        height: 18px;
        color: #7A7A8A;
    }

    .readings-card-title-wrap h3 {
        font-size: 1rem;
        font-weight: 700;
        color: #1A1A1A;
    }

    .readings-date-wrap {
        width: 160px;
    }

    .readings-date-input::-webkit-calendar-picker-indicator {
        filter: brightness(0) saturate(100%);
        opacity: 0.75;
        cursor: pointer;
    }

    .readings-card-body {
        display: grid;
        grid-template-columns: 1fr auto 1fr 1fr;
        gap: 16px;
        align-items: center;
    }

    .readings-stat-label {
        margin-bottom: 8px;
        color: #7A7A8A;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .readings-prev-box {
        min-height: 50px;
        padding: 12px 16px;
        border-radius: 10px;
        background: #F7F6F2;
        color: #7A7A8A;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .readings-arrow-wrap {
        align-self: end;
        padding-bottom: 14px;
        color: #7A7A8A;
    }

    .readings-arrow-wrap i {
        width: 18px;
        height: 18px;
    }

    .readings-current-wrap {
        position: relative;
    }

    .readings-current-wrap .form-input {
        padding-right: 38px;
        text-align: center;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .readings-current-wrap .form-input:focus {
        border-color: #4CAF7D;
    }

    .readings-unit-suffix {
        position: absolute;
        top: 50%;
        right: 14px;
        transform: translateY(-50%);
        color: #7A7A8A;
        font-weight: 700;
        font-size: 0.8rem;
        pointer-events: none;
    }

    .inline-error {
        display: none;
        margin-top: 8px;
        color: #EF4444;
        font-size: 0.78rem;
    }

    .diff-display {
        min-height: 50px;
        padding: 12px 16px;
        border: 1px solid #E8E7E2;
        border-radius: 10px;
        background: #FFFFFF;
        color: #7A7A8A;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }

    .diff-display.is-positive {
        color: #2E7D52;
        border-color: #CDE9D8;
        background: #F5FBF7;
    }

    .diff-display.is-negative {
        color: #EF4444;
        border-color: #F7C5C5;
        background: #FEF2F2;
    }

    .readings-sticky-shell {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        height: 80px;
        background: #FFFFFF;
        border-top: 1px solid #F0EFE9;
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.06);
        z-index: 1400;
    }

    .readings-sticky-bar {
        max-width: 1300px;
        height: 100%;
        margin: 0 auto;
        padding: 0 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .readings-sticky-summary {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .readings-total-distributed {
        color: #1A1A1A;
        font-size: 1.1rem;
        font-weight: 800;
    }

    .readings-match-pill {
        min-height: 34px;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .readings-match-pill.is-waiting {
        background: #F0EFE9;
        color: #7A7A8A;
    }

    .readings-match-pill.is-diff {
        background: #FFF0E6;
        color: #CC4A0C;
    }

    .readings-match-pill.is-match {
        background: #E6F4ED;
        color: #2E7D52;
    }

    .readings-sticky-actions {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .readings-submit-btn:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    @media (max-width: 768px) {
        .readings-context-bar {
            padding: 20px;
        }

        .readings-card-top {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }

        .readings-date-wrap {
            width: 100%;
        }

        .readings-card-body {
            display: grid;
            grid-template-columns: 1fr;
            grid-template-areas: none;
            gap: 16px;
        }

        .readings-card-body > * {
            grid-area: auto !important;
        }

        .readings-arrow-wrap {
            display: none;
        }

        .readings-form {
            padding-bottom: 150px;
        }

        .readings-sticky-shell {
            height: auto;
            padding: 16px 0;
        }

        .readings-sticky-bar {
            padding: 0 16px;
            flex-direction: column;
            align-items: stretch;
            gap: 16px;
        }

        .readings-sticky-summary {
            justify-content: space-between;
        }

        .readings-sticky-actions {
            width: 100%;
        }

        .readings-sticky-actions .btn {
            flex: 1;
            justify-content: center;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const inputs = document.querySelectorAll('.current-reading-input');
        const totalDistributedEl = document.getElementById('totalDistributed');
        const matchIndicator = document.getElementById('matchIndicator');
        const submitBtn = document.getElementById('submitBtn');
        const targetUnits = parseFloat("<%= mainBill.total_units %>");

        const updateCalculations = () => {
            let totalDiff = 0;
            let hasErrors = false;
            let allFilled = true;

            inputs.forEach((input) => {
                const previous = parseFloat(input.dataset.prev || '0');
                const currentRaw = input.value.trim();
                const current = parseFloat(currentRaw);
                const card = input.closest('.readings-room-card');
                const diffDisplay = card.querySelector('.diff-display');
                const errorMsg = card.querySelector('.inline-error');

                card.classList.remove('is-valid', 'is-error');
                diffDisplay.textContent = '—';
                diffDisplay.classList.remove('is-positive', 'is-negative');
                errorMsg.style.display = 'none';

                if (currentRaw === '') {
                    allFilled = false;
                    return;
                }

                if (Number.isNaN(current) || current < previous) {
                    hasErrors = true;
                    card.classList.add('is-error');
                    diffDisplay.classList.add('is-negative');
                    diffDisplay.textContent = Number.isNaN(current) ? '—' : `${(current - previous).toFixed(1)} U`;
                    errorMsg.style.display = 'block';
                    return;
                }

                const diff = current - previous;
                totalDiff += diff;
                card.classList.add('is-valid');
                diffDisplay.classList.add('is-positive');
                diffDisplay.textContent = `+${diff.toFixed(1)} U`;
            });

            totalDistributedEl.textContent = totalDiff.toFixed(1);

            if (!allFilled) {
                matchIndicator.className = 'readings-match-pill is-waiting';
                matchIndicator.textContent = 'Awaiting Input';
            } else {
                const delta = totalDiff - targetUnits;
                if (Math.abs(delta) < 0.1) {
                    matchIndicator.className = 'readings-match-pill is-match';
                    matchIndicator.textContent = 'Units Match ✓';
                } else {
                    matchIndicator.className = 'readings-match-pill is-diff';
                    matchIndicator.textContent = `Differ by ${Math.abs(delta).toFixed(1)} U`;
                }
            }

            submitBtn.disabled = hasErrors || !allFilled;
        };

        inputs.forEach((input) => {
            input.addEventListener('input', updateCalculations);
        });

        document.getElementById('readingsForm')?.addEventListener('submit', (event) => {
            updateCalculations();
            if (submitBtn.disabled) {
                event.preventDefault();
            }
        });

        updateCalculations();
    });
</script>
