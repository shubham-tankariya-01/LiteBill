<% layout('layouts/boilerplate') %>

<section class="setup-stepper">
    <div class="setup-step-pill">1. Add House</div>
    <i data-lucide="arrow-right" class="setup-step-arrow"></i>
    <div class="setup-step-pill">2. Configure Meters</div>
    <i data-lucide="arrow-right" class="setup-step-arrow"></i>
    <div class="setup-step-pill setup-step-pill-active">3. Set Baseline ●</div>
    <i data-lucide="arrow-right" class="setup-step-arrow"></i>
    <div class="setup-step-pill">4. Ready</div>
</section>

<section class="setup-header">
    <h1>Initial House Setup</h1>
    <p>Set the opening meter values once so every future cycle starts from the correct baseline.</p>
</section>

<section class="setup-info-card" id="setupInfoCard">
    <div class="setup-info-copy">
        <i data-lucide="info"></i>
        <div>
            <div class="setup-info-title">One-Time Setup Required</div>
            <p>Enter the reading currently visible on each physical meter. These values become your starting baseline for all future billing cycles in this property.</p>
        </div>
    </div>
    <span class="badge badge-dim setup-info-badge" id="setupInfoBadge">0 / <%= rooms.length %> rooms filled</span>
</section>

<div class="setup-progress-wrap">
    <span class="setup-progress-badge badge badge-dim" id="progressCounter">0 / <%= rooms.length %> rooms filled</span>
</div>

<form action="/houses/<%= houseId %>/readings/setup" method="POST" id="setupForm" class="setup-form">
    <% rooms.forEach((room) => { %>
        <article class="setup-room-card">
            <div class="setup-room-icon">
                <i data-lucide="gauge"></i>
            </div>

            <div class="setup-room-body">
                <h4><%= room.meter_name %></h4>

                <div class="setup-room-fields">
                    <div class="form-group setup-reading-group">
                        <label class="form-label" for="reading_<%= room._id %>">Opening Reading</label>
                        <div class="setup-input-combo">
                            <input
                                id="reading_<%= room._id %>"
                                type="number"
                                min="0"
                                step="0.1"
                                name="readings[<%= room._id %>][units]"
                                class="form-input setup-reading-input"
                                placeholder="0.0"
                                required
                            >
                            <span class="setup-suffix-chip">U</span>
                        </div>
                    </div>

                    <div class="form-group setup-date-group">
                        <label class="form-label" for="date_<%= room._id %>">Date</label>
                        <input
                            id="date_<%= room._id %>"
                            type="date"
                            name="readings[<%= room._id %>][date]"
                            class="form-input setup-date-input"
                            value="<%= new Date().toISOString().split('T')[0] %>"
                            required
                        >
                    </div>
                </div>

                <div class="setup-validation-msg">Value must be 0 or greater.</div>
            </div>
        </article>
    <% }) %>

    <div class="setup-actions">
        <a href="/houses/<%= houseId %>" class="btn btn-secondary">Cancel</a>
        <button type="submit" id="submitBtn" class="btn btn-primary setup-submit-btn" disabled>Complete Setup -&gt;</button>
    </div>
</form>

<style>
    .setup-stepper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 28px;
    }

    .setup-step-pill {
        min-height: 40px;
        padding: 0 14px;
        border-radius: 999px;
        border: 1px solid #E8E7E2;
        background: transparent;
        color: #7A7A8A;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.82rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .setup-step-pill-active {
        background: #1F1F1F;
        border-color: #1F1F1F;
        color: #FFFFFF;
    }

    .setup-step-arrow {
        width: 16px;
        height: 16px;
        color: #7A7A8A;
    }

    .setup-header {
        max-width: 560px;
        margin: 0 auto 24px;
        text-align: center;
    }

    .setup-header h1 {
        margin-bottom: 10px;
        font-size: 2rem;
        font-weight: 800;
        line-height: 1.1;
    }

    .setup-header p {
        color: #7A7A8A;
        font-size: 0.95rem;
    }

    .setup-info-card {
        position: relative;
        max-width: 560px;
        margin: 0 auto 20px;
        padding: 20px;
        border-radius: 16px;
        background: #EBF1FD;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
    }

    .setup-info-copy {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .setup-info-copy i {
        width: 20px;
        height: 20px;
        color: #2C5CC5;
        margin-top: 2px;
        flex-shrink: 0;
    }

    .setup-info-title {
        color: #2C5CC5;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .setup-info-copy p {
        color: #45628D;
        font-size: 0.88rem;
        line-height: 1.55;
    }

    .setup-info-badge {
        flex-shrink: 0;
        align-self: flex-start;
    }

    .setup-progress-wrap {
        max-width: 560px;
        margin: 0 auto 18px;
        display: flex;
        justify-content: center;
    }

    .setup-progress-badge {
        min-height: 36px;
        padding: 6px 14px;
        font-size: 0.82rem;
    }

    .setup-form {
        max-width: 560px;
        margin: 0 auto;
        padding-bottom: 32px;
    }

    .setup-room-card {
        background: #FFFFFF;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        gap: 16px;
        margin-bottom: 12px;
        border-left: 4px solid #E8E7E2;
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.07);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .setup-room-card.is-valid {
        border-left-color: #4CAF7D;
    }

    .setup-room-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
    }

    .setup-room-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #F7F6F2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .setup-room-icon i {
        width: 20px;
        height: 20px;
        color: #7A7A8A;
    }

    .setup-room-body {
        flex: 1;
        min-width: 0;
    }

    .setup-room-body h4 {
        margin-bottom: 12px;
        font-size: 1rem;
        font-weight: 700;
        color: #1A1A1A;
    }

    .setup-room-fields {
        display: flex;
        gap: 12px;
    }

    .setup-reading-group {
        flex: 2;
    }

    .setup-date-group {
        flex: 1;
    }

    .setup-input-combo {
        display: flex;
        align-items: stretch;
    }

    .setup-input-combo .form-input {
        flex: 1;
        border-radius: 12px 0 0 12px;
    }

    .setup-suffix-chip {
        min-height: 48px;
        padding: 14px 12px;
        border-radius: 0 12px 12px 0;
        background: #F0EFE9;
        border: 1.5px solid #E8E7E2;
        border-left: 0;
        color: #7A7A8A;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .setup-date-input::-webkit-calendar-picker-indicator {
        filter: brightness(0) saturate(100%);
        opacity: 0.75;
        cursor: pointer;
    }

    .setup-validation-msg {
        margin-top: 10px;
        color: #EF4444;
        font-size: 0.78rem;
        display: none;
    }

    .setup-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .setup-actions .btn:first-child {
        flex: 1;
    }

    .setup-submit-btn {
        flex: 2;
        transition: opacity 0.2s ease, background 0.2s ease, transform 0.15s ease;
    }

    @media (max-width: 768px) {
        .setup-room-card {
            width: 100%;
        }

        .setup-room-fields {
            flex-direction: column;
        }

        .setup-form {
            max-width: 100%;
            padding-bottom: 40px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const readingInputs = document.querySelectorAll('.setup-reading-input');
        const progressCounter = document.getElementById('progressCounter');
        const infoBadge = document.getElementById('setupInfoBadge');
        const submitBtn = document.getElementById('submitBtn');
        const totalRooms = <%= rooms.length %>;

        const setBadgeState = (filled) => {
            const text = `${filled} / ${totalRooms} rooms filled`;
            progressCounter.textContent = text;
            infoBadge.textContent = text;

            const complete = filled === totalRooms && totalRooms > 0;
            progressCounter.className = complete ? 'setup-progress-badge badge badge-green' : 'setup-progress-badge badge badge-dim';
            infoBadge.className = complete ? 'badge badge-green setup-info-badge' : 'badge badge-dim setup-info-badge';
        };

        const validateCards = () => {
            let filled = 0;
            let hasError = false;

            readingInputs.forEach((input) => {
                const card = input.closest('.setup-room-card');
                const message = card.querySelector('.setup-validation-msg');
                const rawValue = input.value.trim();
                const value = parseFloat(rawValue);

                card.classList.remove('is-valid');
                message.style.display = 'none';

                if (rawValue === '') {
                    return;
                }

                if (Number.isNaN(value) || value < 0) {
                    hasError = true;
                    message.style.display = 'block';
                    return;
                }

                filled += 1;
                card.classList.add('is-valid');
            });

            setBadgeState(filled);
            submitBtn.disabled = hasError || filled !== totalRooms;
        };

        readingInputs.forEach((input) => {
            input.addEventListener('input', validateCards);
        });

        document.getElementById('setupForm')?.addEventListener('submit', (event) => {
            validateCards();
            if (submitBtn.disabled) {
                event.preventDefault();
            }
        });

        setBadgeState(0);
    });
</script>
