<% layout('layouts/boilerplate') %>

    <% const colors=['#0F172A', '#2563EB' , '#059669' , '#D97706' , '#4F46E5' , '#64748B' ]; const
        totalDistributedAmount=roomBills.reduce((sum, bill)=> sum + (bill.amount || 0), 0);
        const totalDistributedUnits = roomBills.reduce((sum, bill) => sum + (bill.units_consumed || 0), 0);
        const totalPreviousReadings = roomBills.reduce((sum, bill) => sum + Number(bill.previous_reading || 0), 0);
        const totalCurrentReadings = roomBills.reduce((sum, bill) => sum + Number(bill.current_reading || 0), 0);
        const totalRawUnits = roomBills.reduce((sum, bill) => sum + ((Number(bill.current_reading || 0) -
        Number(bill.previous_reading || 0)) || 0), 0);
        const totalAdjustmentUnits = roomBills.reduce((sum, bill) => {
        const rawUnits = Number(bill.current_reading || 0) - Number(bill.previous_reading || 0);
        return sum + ((Number(bill.units_consumed || 0) - rawUnits) || 0);
        }, 0);
        const highestBill = roomBills.reduce((top, bill) => {
        return Number(bill.amount || 0) > Number((top && top.amount) || 0) ? bill : top;
        }, roomBills[0] || null);
        const highestBillPct = totalDistributedAmount > 0 && highestBill
        ? ((Number(highestBill.amount || 0) / totalDistributedAmount) * 100).toFixed(1)
        : '0.0';
        const periodStart = cycle.startDate ? new Date(cycle.startDate).toLocaleDateString('en-IN', { day: 'numeric',
        month: 'short', year: 'numeric' }) : 'N/A';
        const periodEnd = cycle.endDate ? new Date(cycle.endDate).toLocaleDateString('en-IN', { day: 'numeric', month:
        'short', year: 'numeric' }) : 'Present';
        const ratePerUnit = hasBill && Number(mainBill.total_units || 0) > 0
        ? Number(mainBill.total_amount || 0) / Number(mainBill.total_units || 0)
        : 0;
        const differenceValue = Number(billDifference || 0);
        const isVerified = hasBill && differenceValue < 1; %>

            <div class="distribution-breadcrumb">Properties / <span>
                    <%= cycle.house.house_name %>
                </span> / Cycles / Distribution</div>

            <section class="page-header distribution-header">
                <div>
                    <h1 class="distribution-title">
                        <i data-lucide="pie-chart"></i>
                        <span>Room Distribution</span>
                    </h1>
                    <p class="distribution-subtitle">
                        <%= periodStart %> - <%= periodEnd %>
                    </p>
                </div>

                <div style="display: flex; gap: 12px;">
                    <button id="downloadPdfBtn" class="btn btn-primary" onclick="generateBillPDF()"
                        style="border-radius: 999px; display: flex; align-items: center; gap: 0.5rem; background-color: #FF6B35; border-color: #FF6B35;">
                        <i data-lucide="download" style="width: 18px; height: 18px;"></i>
                        <span>Download Bill PDF</span>
                    </button>
                </div>
            </section>

            <% if (!hasBill) { %>
                <section class="distribution-warning-card">
                    <i data-lucide="alert-triangle"></i>
                    <div>
                        <div class="distribution-warning-title">No Main Bill</div>
                        <div class="distribution-warning-copy">Add the supplier bill for this cycle before final room
                            distribution can be verified accurately.</div>
                    </div>
                </section>
                <% } %>

                    <% if (hasBill) { %>
                        <section class="gradient-border-card distribution-summary-card">
                            <div class="distribution-summary-top">
                                <div class="distribution-summary-left">
                                    <div class="distribution-summary-icon">
                                        <i data-lucide="indian-rupee"></i>
                                    </div>
                                    <div>
                                        <div class="distribution-summary-label">Total Supplier Bill</div>
                                        <div class="distribution-summary-value">&#8377;<%= Number(mainBill.total_amount
                                                || 0).toLocaleString('en-IN') %>
                                        </div>
                                    </div>
                                </div>

                                <div class="distribution-summary-chips">
                                    <div class="distribution-summary-chip">
                                        <div class="distribution-summary-chip-label">Total Units</div>
                                        <div class="distribution-summary-chip-value">
                                            <%= Number(mainBill.total_units || 0).toLocaleString('en-IN') %> U
                                        </div>
                                    </div>
                                    <div class="distribution-summary-chip">
                                        <div class="distribution-summary-chip-label">Rate Per Unit</div>
                                        <div class="distribution-summary-chip-value">&#8377;<%= ratePerUnit.toFixed(2)
                                                %>
                                        </div>
                                    </div>
                                    <div class="distribution-summary-chip">
                                        <div class="distribution-summary-chip-label">Bill Date</div>
                                        <div class="distribution-summary-chip-value">
                                            <%= mainBill.bill_date ? new
                                                Date(mainBill.bill_date).toLocaleDateString('en-IN', { day: 'numeric' ,
                                                month: 'short' , year: 'numeric' }) : 'N/A' %>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="distribution-summary-bottom">
                                <div class="distribution-summary-highlights">
                                    <div class="distribution-highlight-card is-primary">
                                        <span class="distribution-highlight-label">Generated Total</span>
                                        <strong class="distribution-highlight-value">&#8377;<%=
                                                Number(totalDistributedAmount || 0).toLocaleString('en-IN', {
                                                minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
                                    </div>

                                    <div
                                        class="distribution-highlight-card <%= isVerified ? 'is-success' : 'is-warning' %>">
                                        <span class="distribution-highlight-label">Difference</span>
                                        <strong class="distribution-highlight-value">&#8377;<%=
                                                differenceValue.toLocaleString('en-IN', { minimumFractionDigits: 2,
                                                maximumFractionDigits: 2 }) %></strong>
                                    </div>

                                    <div class="distribution-highlight-card">
                                        <span class="distribution-highlight-label">Rooms Billed</span>
                                        <strong class="distribution-highlight-value">
                                            <%= roomBills.length %>
                                        </strong>
                                    </div>

                                    <% if (highestBill) { %>
                                        <div class="distribution-highlight-card">
                                            <span class="distribution-highlight-label">Largest Share</span>
                                            <strong class="distribution-highlight-value">
                                                <%= highestBill.room_id ? highestBill.room_id.meter_name
                                                    : 'Deleted Room' %> - <%= highestBillPct %>%
                                            </strong>
                                        </div>
                                        <% } %>
                                </div>

                                <div class="distribution-verify-pill <%= isVerified ? 'is-verified' : 'is-mismatch' %>">
                                    <i data-lucide="<%= isVerified ? 'check-circle' : 'alert-triangle' %>"></i>
                                    <span>
                                        <%= isVerified ? 'Distribution Verified' : 'Mismatch Detected' %>
                                    </span>
                                </div>
                            </div>
                        </section>
                        <% } %>

                            <% if (roomBills.length> 0) { %>
                                <section class="glass-card-tinted distribution-visual-card"
                                    style="padding: 24px; margin-bottom: 24px;">
                                    <div class="distribution-card-title">
                                        <i data-lucide="align-left"></i>
                                        <span>Usage Distribution</span>
                                    </div>

                                    <div class="distribution-bar">
                                        <% roomBills.forEach((bill, index)=> {
                                            const amount = Number(bill.amount || 0);
                                            const width = totalDistributedAmount > 0 ? Math.max((amount /
                                            totalDistributedAmount) * 100, 4) : 0;
                                            %>
                                            <span class="distribution-bar-segment"
                                                style="width: <%= width %>%; background: <%= colors[index % colors.length] %>;"
                                                title="<%= bill.room_id ? bill.room_id.meter_name : 'Room' %>"></span>
                                            <% }) %>
                                    </div>

                                    <div class="distribution-legend">
                                        <% roomBills.forEach((bill, index)=> {
                                            const pct = totalDistributedAmount > 0 ? ((Number(bill.amount || 0) /
                                            totalDistributedAmount) * 100).toFixed(1) : '0.0';
                                            %>
                                            <div class="distribution-legend-item">
                                                <span class="distribution-legend-swatch"
                                                    style="background: <%= colors[index % colors.length] %>;"></span>
                                                <span class="distribution-legend-name">
                                                    <%= bill.room_id ? bill.room_id.meter_name : 'Deleted Room' %>
                                                </span>
                                                <span class="distribution-legend-pct">
                                                    <%= pct %>%
                                                </span>
                                            </div>
                                            <% }) %>
                                    </div>
                                </section>

                                <section class="card distribution-table-card">
                                    <div class="distribution-table-head multi-color-border">
                                        <div class="distribution-card-title" style="margin-bottom: 0;">
                                            <i data-lucide="list"></i>
                                            <span>Room Invoices</span>
                                        </div>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="data-table">
                                            <thead>
                                                <tr>
                                                    <th>Room Name</th>
                                                    <th style="text-align: right;">Prev Reading</th>
                                                    <th style="text-align: right;">Curr Reading</th>
                                                    <th style="text-align: right;">Units</th>
                                                    <th style="min-width: 180px;">Proportion</th>
                                                    <th style="text-align: right;">Amount</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% roomBills.forEach((bill, index)=> {
                                                    const pct = totalDistributedAmount > 0 ? (Number(bill.amount || 0) /
                                                    totalDistributedAmount) * 100 : 0;
                                                    %>
                                                    <tr>
                                                        <td>
                                                            <div class="distribution-room-name">
                                                                <span class="distribution-room-dot"
                                                                    style="background: <%= colors[index % colors.length] %>;"></span>
                                                                <span>
                                                                    <%= bill.room_id ? bill.room_id.meter_name
                                                                        : 'Deleted Room' %>
                                                                </span>
                                                            </div>
                                                        </td>
                                                        <td style="text-align: right;">
                                                            <%= bill.previous_reading %>
                                                        </td>
                                                        <td style="text-align: right;">
                                                            <%= bill.current_reading %>
                                                        </td>
                                                        <td style="text-align: right;">
                                                            <%= bill.units_consumed %>
                                                        </td>
                                                        <td>
                                                            <div class="distribution-proportion-cell">
                                                                <div class="distribution-proportion-track">
                                                                    <div class="distribution-proportion-fill"
                                                                        style="width: <%= pct %>%; background: <%= colors[index % colors.length] %>;">
                                                                    </div>
                                                                </div>
                                                                <span class="distribution-proportion-pct">
                                                                    <%= pct.toFixed(1) %>%
                                                                </span>
                                                            </div>
                                                        </td>
                                                        <td class="distribution-amount-cell">&#8377;<%=
                                                                Number(bill.amount || 0).toLocaleString('en-IN', {
                                                                minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                            </tbody>
                                            <tfoot>
                                                <tr class="distribution-footer-row">
                                                    <td colspan="3" style="text-align: right;">
                                                        <div class="distribution-footer-title">Total Distributed</div>
                                                        <div class="distribution-footer-subtitle">Final bill allocation
                                                            across all room invoices</div>
                                                    </td>
                                                    <td style="text-align: right;"><strong>
                                                            <%= totalDistributedUnits %>
                                                        </strong></td>
                                                    <td></td>
                                                    <td class="distribution-footer-amount"><strong>&#8377;<%=
                                                                totalDistributedAmount.toLocaleString('en-IN', {
                                                                minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                                        </strong></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </section>
                                <% } else { %>
                                    <div class="card empty-state distribution-empty-state">
                                        <div class="empty-state-icon"
                                            style="width: 88px; height: 88px; border-radius: 24px;">
                                            <i data-lucide="file-x"
                                                style="width: 40px; height: 40px; color: #7A7A8A;"></i>
                                        </div>
                                        <div class="empty-state-title">No Room Bills Yet</div>
                                        <div class="empty-state-description">Room bills will appear here automatically
                                            after final readings are submitted for this cycle.</div>
                                    </div>
                                    <% } %>

                                        <link rel="stylesheet" href="/public/css/billing/report.css">

                                        <script
                                            src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
                                        <script
                                            src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
                                        <script src="/public/js/utilities/pdf_engine.js"></script>

                                        <script>
                                            const BILL_DATA = {
                                                house: {
                                                    name: <%- JSON.stringify(cycle.house.house_name) %>,
                                                },
                                                cycle: {
                                                    startDate: <%- JSON.stringify(periodStart) %>,
                                                    endDate: <%- JSON.stringify(periodEnd) %>,
                                                },
                                                mainBill: {
                                                    totalUnits: <%= Number(hasBill ? mainBill.total_units : 0) %>,
                                                    totalAmount: <%= Number(hasBill ? mainBill.total_amount : 0) %>,
                                                    billDate: <%- JSON.stringify(hasBill && mainBill.bill_date ? new Date(mainBill.bill_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : 'N/A') %>,
                                                    ratePerUnit: <%= Number(ratePerUnit.toFixed(4)) %>,
                                                },
                                                roomBills: [
                                                    <% roomBills.forEach((bill, index) => {
                                                        const rawUnits = Number(bill.current_reading || 0) - Number(bill.previous_reading || 0);
                                                        const finalUnits = Number(bill.units_consumed || 0);
                                                        const adjustmentUnits = finalUnits - rawUnits;
                                                    %>
                                                    {
                                                        roomName: <%- JSON.stringify(bill.room_id ? bill.room_id.meter_name : 'Room ' + (index + 1)) %>,
                                                        previousReading: <%= Number(bill.previous_reading || 0) %>,
                                                        currentReading: <%= Number(bill.current_reading || 0) %>,
                                                        rawUnitsConsumed: <%= rawUnits %>,
                                                        adjustedUnitsConsumed: <%= finalUnits %>,
                                                        adjustmentUnits: <%= adjustmentUnits %>,
                                                        amount: <%= Number(bill.amount || 0) %>,
                                                        proportion: <%= totalDistributedAmount > 0 ? Number(((bill.amount || 0) / totalDistributedAmount) * 100).toFixed(2) : 0 %>,
                                                    }<%= index < roomBills.length - 1 ? ',' : '' %>
                                                    <% }) %>
                                                ],
                                                summary: {
                                                    totalRoomBills: <%= Number(totalDistributedAmount || 0) %>,
                                                    totalDistributedUnits: <%= Number(totalDistributedUnits || 0) %>,
                                                    totalPreviousReadings: <%= Number(totalPreviousReadings || 0) %>,
                                                    totalCurrentReadings: <%= Number(totalCurrentReadings || 0) %>,
                                                    totalRawUnits: <%= Number(totalRawUnits || 0) %>,
                                                    totalAdjustmentUnits: <%= Number(totalAdjustmentUnits || 0) %>,
                                                    billDifference: <%= Number((differenceValue || 0).toFixed(2)) %>,
                                                    isVerified: <%= typeof isVerified !== 'undefined' ? isVerified : false %>,
                                                    roomCount: <%= roomBills.length %>,
                                                    generatedAt: <%- JSON.stringify(new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })) %>,
                                                }
                                            };

                                            async function generateBillPDF() {
                                                const btn = document.getElementById('downloadPdfBtn');
                                                if (!btn) return;

                                                const origHTML = btn.innerHTML;
                                                btn.disabled = true;
                                                btn.innerHTML = '<span>Generating PDF...</span>';

                                                try {
                                                    if (!window.LiteBillPDF) {
                                                        throw new Error('PDF Engine not loaded. Please refresh the page.');
                                                    }
                                                    await window.LiteBillPDF.generate(BILL_DATA);
                                                } catch (err) {
                                                    console.error('PDF Error:', err);
                                                    alert('Failed to generate PDF: ' + err.message);
                                                } finally {
                                                    btn.disabled = false;
                                                    btn.innerHTML = origHTML;
                                                    if (window.lucide) lucide.createIcons();
                                                }
                                            }
                                        </script>