<% layout('layouts/boilerplate') %>

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.5rem; font-weight: 600; text-transform: uppercase;">
            <a href="/houses/<%= house._id %>" style="color: var(--text-dim); text-decoration: none;"><%= house.house_name %></a> 
            <span>/</span> 
            <span style="color: var(--accent-purple);">Meters</span>
        </div>
        <h1 style="margin: 0; display: flex; align-items: center; gap: 0.75rem; font-size: 2rem;">
            <i data-lucide="bed-double" style="color: var(--accent-purple);"></i> Meters
        </h1>
        <p class="text-secondary" style="margin-top: 0.5rem;"><%= rooms.length %> meters configured</p>
    </div>
    <a href="/houses/<%= house._id %>/rooms/new" class="btn btn-primary" style="background: var(--accent-purple); color: #fff; border: none;"><i data-lucide="plus"></i> Add Meter</a>
</div>

<% if (rooms.length === 0) { %>
    <div class="card-raised" style="text-align: center; padding: 5rem 2rem; max-width: 600px; margin: 0 auto;">
        <div style="width: 80px; height: 80px; background: rgba(139, 92, 246, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
            <i data-lucide="bed-double" style="width: 40px; height: 40px; color: var(--accent-purple);"></i>
        </div>
        <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem;">No meters configured</h2>
        <p class="text-secondary" style="margin-bottom: 2rem; max-width: 400px; margin-left: auto; margin-right: auto;">
            To calculate individual bills, you need to add the sub-meters installed in this property (e.g., Master Bedroom, Shop 1).
        </p>
        <a href="/houses/<%= house._id %>/rooms/new" class="btn btn-primary" style="padding: 0.8rem 1.5rem; background: var(--accent-purple); border: none;"><i data-lucide="plus"></i> Setup First Meter</a>
    </div>
<% } else { %>
    <div class="grid-3">
        <% rooms.forEach(room => { %>
            <% const data = roomData[room._id.toString()]; %>
            <div class="card-raised card-accent house-card" style="--card-accent-color: var(--accent-purple); display: flex; flex-direction: column;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;">
                    <h3 style="margin: 0; color: var(--text-primary); font-size: 1.3rem; font-weight: 800;"><%= room.meter_name %></h3>
                    <i data-lucide="zap" style="color: var(--accent-purple); opacity: 0.5;"></i>
                </div>
                
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
                    <span class="badge badge-dim" style="display: flex; align-items: center; gap: 0.25rem;">
                        <i data-lucide="indian-rupee" style="width: 12px;"></i> <%- data.latestBill ? data.latestBill.amount : 'N/A' %>
                    </span>
                    <span class="badge badge-dim" style="display: flex; align-items: center; gap: 0.25rem;">
                        <i data-lucide="gauge" style="width: 12px;"></i> <%- data.latestReading ? data.latestReading.reading_value + ' U' : 'No reads' %>
                    </span>
                </div>

                <div style="display: flex; gap: 0.5rem; margin-top: auto;">
                    <a href="/rooms/<%= room._id %>" class="btn btn-secondary" style="flex: 1; border-color: var(--border);">View Profile</a>
                    <a href="/rooms/<%= room._id %>/edit" class="btn btn-icon btn-ghost"><i data-lucide="settings-2"></i></a>
                    <button type="button" class="btn btn-icon btn-ghost" style="color: var(--accent-red);" onclick="openDeleteRoomModal('<%= room._id %>', '<%= room.meter_name %>')">
                        <i data-lucide="trash-2"></i>
                    </button>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>

<style>
    .house-card {
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .house-card:hover {
        transform: translateY(-2px);
        border-color: var(--accent-purple);
        box-shadow: 0 10px 30px rgba(0,0,0,0.6);
    }
</style>

<%- include('../includes/delete_room_modal') %>