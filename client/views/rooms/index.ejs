<% layout('layouts/boilerplate') %>
    <div class="page-header">
        <div>
            <h1><i data-lucide="bed-double" style="color: var(--accent-pink);"></i> &nbsp;
                <%= house.house_name %> &nbsp;
                <span style="color: var(--accent-pink);">All Meters</span>
            </h1>
            <p class="text-muted" style="margin-top: 0.5rem; font-size: 0.9rem;"><%= rooms.length %> meters configured</p>
        </div>
        <a href="/houses/<%= house._id %>/rooms/new" class="btn btn-primary" style="background: var(--accent-pink);"><i
                data-lucide="plus" style="width: 16px; height: 16px;"></i> Add Room</a>
    </div>
    <div class="grid-layout">
        <% rooms.forEach(room=> { %>
            <div class="analytic-card theme-room">
                <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                    <h3 style="margin: 0;">
                        <%= room.meter_name %>
                    </h3>
                </div>
                <p class="text-muted" style="margin-bottom: 0.5rem; font-size: 0.85rem;">Allocated to:
                    <%= house.house_name %>
                </p>
                
                <% const data = roomData[room._id.toString()]; %>
                <div style="display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 1.5rem; font-size: 0.8rem; color: var(--text-muted);">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <i data-lucide="indian-rupee" style="width: 12px; height: 12px;"></i>
                        <span>Last bill: <%- data.latestBill ? '₹' + data.latestBill.amount : 'No bills yet' %></span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <i data-lucide="zap" style="width: 12px; height: 12px;"></i>
                        <span>Last reading: <%- data.latestReading ? data.latestReading.reading_value + ' units' : 'No readings yet' %></span>
                    </div>
                </div>

                <div style="display: flex; gap: 0.5rem; margin-top: auto;">
                    <a href="/rooms/<%= room._id %>" class="btn btn-outline" style="flex: 1;">View Room Profile</a>
                    <a href="/rooms/<%= room._id %>/edit" class="btn btn-outline" style="padding: 0.5rem;">
                        <i data-lucide="settings-2" style="width: 16px; height: 16px;"></i>
                    </a>
                    <form action="/rooms/<%= room._id %>?_method=DELETE" method="POST" style="display: inline; margin: 0;">
                        <button type="submit" class="btn btn-outline" style="padding: 0.5rem; color: #EF4444; border-color: #FCA5A5; height: 100%;" onclick="return confirm('Are you sure you want to delete this meter and all its history?');">
                            <i data-lucide="trash-2" style="width: 16px; height: 16px;"></i>
                        </button>
                    </form>
                </div>
            </div>
            <% }) %>
    </div>

    <!-- Modal for Adding Meters/Rooms -->
    <link rel="stylesheet" href="/public/css/houses.css" />

    <div id="modal" class="modal hidden">
        <div class="modal-content analytic-card theme-room"
            style="padding: 2.5rem; border-top: 4px solid var(--accent-pink);">
            <button type="button" id="closeModalBtn" class="modal-close-btn">
                <i data-lucide="x" style="width: 20px; height: 20px;"></i>
            </button>

            <div id="step1" class="step-container">
                <h2 class="modal-title mb-1">
                    <div class="modal-icon-wrapper" style="background: rgba(209, 124, 148, 0.15);">
                        <i data-lucide="bed-double" style="color: var(--accent-pink);"></i>
                    </div>
                    Add New Meters / Rooms
                </h2>
                <p class="text-muted mb-2" style="font-size: 0.85rem;">Enter the names of the meters to install in <%=
                        house.house_name %>.</p>

                <div id="metersContainer">
                    <div class="form-group meter-row">
                        <input type="text" name="meters[]" class="form-control" placeholder="e.g. Master Bedroom"
                            autocomplete="off" />
                        <button type="button" class="remove-meter-btn" title="Remove" style="visibility: hidden;">
                            <i data-lucide="trash-2" style="width: 18px; height: 18px;"></i>
                        </button>
                    </div>
                </div>

                <button type="button" id="addMeterBtn" class="btn btn-dashed-green"
                    style="border-color: var(--accent-pink); color: #B35875; background: rgba(209, 124, 148, 0.05);">
                    <i data-lucide="plus" class="icon-sm"></i> Add Another
                </button>

                <div class="modal-actions">
                    <button type="button" class="btn btn-outline flex-1"
                        onclick="document.getElementById('closeModalBtn').click()">Cancel</button>
                    <button type="button" id="submitBtn" class="btn btn-primary flex-1-5"
                        style="background: var(--accent-pink);"><i data-lucide="check" class="icon-sm"></i> Complete
                        Setup</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const currentHouseId = "<%= house._id %>";
    </script>
    <script src="/public/js/rooms.js"></script>