<% layout('layouts/boilerplate') %>

<div class="container" style="max-width: 600px;">
    <div class="analytic-card">
        <h2>Add New Room</h2>
        <p class="text-muted" style="margin-bottom: 2rem;">Create a new sub-unit for house ID: <%= houseId %>.</p>

        <form action="/houses/<%= houseId %>/rooms" method="POST">
            <div class="form-group">
                <label class="form-label" for="room_name">Room Name / Label</label>
                <input type="text" id="room_name" name="room_name" class="form-control" required placeholder="e.g. Unit 101 or 1st Floor Right">
            </div>
            
            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">Create Room</button>
                <a href="/houses/<%= houseId %>/rooms" class="btn btn-outline" style="flex: 1;">Cancel</a>
            </div>
        </form>
    </div>
</div>
