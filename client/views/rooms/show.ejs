<% layout('layouts/boilerplate') %>

<div class="analytic-card" style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: start;">
        <div>
            <h2>Room Details (ID: <%= roomId %>)</h2>
            <p class="text-muted">View consumption statistics and past bills.</p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
            <a href="/rooms/<%= roomId %>/edit" class="btn btn-outline"><i data-lucide="edit-2" style="width: 16px; height: 16px;"></i></a>
            <a href="/rooms/<%= roomId %>/analysis" class="btn btn-outline" style="color: var(--primary); border-color: var(--primary);"><i data-lucide="bar-chart-2" style="width: 16px; height: 16px;"></i> Insights</a>
        </div>
    </div>
</div>

<div class="grid-layout">
    <div class="analytic-card border-top-pink">
        <h3 style="color: var(--accent-pink-light);">Recent Bills</h3>
        <p class="text-muted">Displays recent calculated room bills mapping to BillingCycles.</p>
    </div>
</div>
