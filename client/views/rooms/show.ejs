<% layout('layouts/boilerplate') %>

<!-- Header -->
<div style="margin-bottom: 2.5rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.75rem; font-weight: 600; text-transform: uppercase;">
        <a href="/houses" style="color: var(--text-dim); text-decoration: none;">Properties</a> 
        <span>/</span> 
        <a href="/houses/<%= house._id %>" style="color: var(--text-dim); text-decoration: none;"><%= house.house_name %></a>
        <span>/</span>
        <span style="color: var(--accent-purple);"><%= room.meter_name %></span>
    </div>
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <h1 style="margin: 0; display: flex; align-items: center; gap: 0.75rem; font-size: 2.25rem;">
            <i data-lucide="bed-double" style="color: var(--accent-purple); width: 32px; height: 32px;"></i> <%= room.meter_name %>
        </h1>
        <div style="display: flex; gap: 0.5rem;">
            <a href="/rooms/<%= roomId %>/edit" class="btn btn-ghost"><i data-lucide="settings-2"></i> Edit</a>
            <button type="button" class="btn btn-icon btn-ghost" style="color: var(--accent-red);" onclick="openDeleteRoomModal('<%= roomId %>', '<%= room.meter_name %>')">
                <i data-lucide="trash-2"></i>
            </button>
        </div>
    </div>
</div>

<%
    let totalBilled = 0;
    let totalUnits = 0;
    let billCount = 0;
    let avgUnits = '0.0';

    if (typeof roomBills !== 'undefined' && roomBills.length > 0) {
        totalBilled = roomBills.reduce((s,b) => s + b.amount, 0);
        totalUnits = roomBills.reduce((s,b) => s + b.units_consumed, 0);
        billCount = roomBills.length;
        avgUnits = (totalUnits / billCount).toFixed(1);
    }
%>

<!-- Hero Stat Bar -->
<div class="card-raised" style="margin-bottom: 2.5rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
    <!-- Total Billed -->
    <div style="flex: 1; min-width: 200px; display: flex; align-items: center; gap: 1rem; padding: 0.5rem;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(45, 212, 191, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <i data-lucide="indian-rupee" style="color: var(--accent-green);"></i>
        </div>
        <div>
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-secondary); font-weight: 700; margin-bottom: 0.25rem;">Total Billed</div>
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);">₹<%= totalBilled.toLocaleString() %></div>
        </div>
    </div>
    
    <div style="width: 1px; background: var(--border); display: none; @media(min-width: 768px) { display: block; }"></div>
    
    <!-- Avg Units -->
    <div style="flex: 1; min-width: 200px; display: flex; align-items: center; gap: 1rem; padding: 0.5rem;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(77, 159, 236, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <i data-lucide="zap" style="color: var(--accent-blue);"></i>
        </div>
        <div>
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-secondary); font-weight: 700; margin-bottom: 0.25rem;">Avg Units/month</div>
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);"><%= avgUnits %> <span style="font-size: 1rem; color: var(--text-secondary); font-weight: 600;">U</span></div>
        </div>
    </div>

    <div style="width: 1px; background: var(--border); display: none; @media(min-width: 768px) { display: block; }"></div>
    
    <!-- Bills Generated -->
    <div style="flex: 1; min-width: 200px; display: flex; align-items: center; gap: 1rem; padding: 0.5rem;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(139, 92, 246, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <i data-lucide="file-text" style="color: var(--accent-purple);"></i>
        </div>
        <div>
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-secondary); font-weight: 700; margin-bottom: 0.25rem;">Bills Generated</div>
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);"><%= billCount %></div>
        </div>
    </div>
</div>

<!-- Bills Table -->
<div class="card-raised" style="padding: 0; overflow: hidden;">
    <div style="padding: 1.5rem 2rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <h3 style="margin: 0; font-size: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
            <i data-lucide="history" style="color: var(--text-muted);"></i> Billing History
        </h3>
        <a href="/rooms/<%= roomId %>/analysis" class="btn btn-secondary" style="border-color: var(--accent-purple); color: var(--accent-purple);">
            <i data-lucide="bar-chart-2"></i> View Analysis &rarr;
        </a>
    </div>

    <% if (typeof roomBills !== 'undefined' && roomBills.length > 0) { %>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Period</th>
                        <th>Prev Reading</th>
                        <th>Current Reading</th>
                        <th>Units Consumed</th>
                        <th style="text-align: right;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <% roomBills.forEach(bill => { %>
                        <tr>
                            <td style="font-weight: 600;">
                                <%= bill.billing_cycle_id && bill.billing_cycle_id.startDate ? bill.billing_cycle_id.startDate.toLocaleDateString('en-IN', {month: 'short', year: 'numeric'}) : 'N/A' %>
                                <% if (bill.billing_cycle_id && bill.billing_cycle_id.endDate) { %>
                                    <span style="color: var(--text-dim); font-weight: 400; font-size: 0.85rem; margin-left: 0.5rem;">
                                        (&rarr; <%= bill.billing_cycle_id.endDate.toLocaleDateString('en-IN', {month: 'short', day: 'numeric'}) %>)
                                    </span>
                                <% } %>
                            </td>
                            <td><%= bill.previous_reading %></td>
                            <td><%= bill.current_reading %></td>
                            <td><%= bill.units_consumed %> <span style="color: var(--text-dim); font-size: 0.8rem;">U</span></td>
                            <td style="text-align: right; font-weight: 800; color: var(--accent-green); font-size: 1.05rem;">₹<%= bill.amount.toLocaleString() %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div style="padding: 4rem 2rem; text-align: center;">
            <i data-lucide="receipt" style="width: 48px; height: 48px; color: var(--border); margin-bottom: 1rem;"></i>
            <h3 style="font-size: 1.25rem; color: var(--text-primary); margin-bottom: 0.5rem;">No bills recorded</h3>
            <p class="text-secondary" style="max-width: 300px; margin: 0 auto;">Once a billing cycle is completed, the finalized bills for this meter will appear here.</p>
        </div>
    <% } %>
</div>

<%- include('../includes/delete_room_modal') %>
